#!/bin/bash

PROJECT="/Users/adam/soi.uz"

echo "🚀 Starting SOI.UZ..."

# PostgreSQL
echo "📦 Starting PostgreSQL..."
brew services start postgresql@17 >/dev/null 2>&1

# MinIO
echo "🗄 Starting MinIO..."

if ! pgrep -x "minio" > /dev/null
then
    nohup minio server /Users/adam/minio-data --console-address :9001 \
    > /Users/adam/minio.log 2>&1 &
else
    echo "MinIO already running"
fi


# Backend
echo "⚙️ Starting API..."

cd $PROJECT/server

if ! lsof -i :4000 >/dev/null
then
    nohup npm run start:dev \
    > /Users/adam/soi-api.log 2>&1 &
else
    echo "API already running"
fi


# Frontend
echo "🌐 Starting Frontend..."

cd $PROJECT/project

if ! lsof -i :3456 >/dev/null
then
    nohup node dev-server.js \
    > /Users/adam/soi-front.log 2>&1 &
else
    echo "Frontend already running"
fi


echo ""
echo "✅ SOI.UZ started"
echo ""
echo "Frontend:"
echo "http://localhost:3456"
echo ""
echo "API:"
echo "http://localhost:4000/api"
echo ""
echo "Swagger:"
echo "http://localhost:4000/api/docs"Last login: Tue Jul 28 22:16:59 on ttys000
