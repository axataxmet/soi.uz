{
  "name": "soi-uz",
  "version": "0.1.0",
  "private": true,
  "description": "ИНДУСТРИЯ ЗДОРОВЬЯ — сайт и админ-панель. Сайт (project/app/*.jsx) собирается заранее через Babel (npm run build:app) в project/dist/; админка по-прежнему компилирует JSX в браузере через CDN Babel.",
  "scripts": {
    "dev": "node project/dev-server.js",
    "build:app": "node scripts/build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
