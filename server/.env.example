# ── App ──
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3456

# ── Database (Postgres) ──
# For local `npm run` against the Docker DB use localhost; inside Docker the host is `postgres`.
DATABASE_URL=postgresql://soi:soi_password@localhost:5432/soi?schema=public
POSTGRES_USER=soi
POSTGRES_PASSWORD=soi_password
POSTGRES_DB=soi
POSTGRES_PORT=5432

# ── JWT ──
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── S3 / MinIO ──
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=soi-media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=soi-media

# ── Seed (first superadmin) ──
SEED_ADMIN_EMAIL=admin@soi.uz
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── e-tender (UZEX): isolated schema/pool + daily sync ──
# Own Postgres schema; if unset it is derived from DATABASE_URL with ?schema=etender
ETENDER_DATABASE_URL=
ETENDER_API_BASE=https://apietender.uzex.uz
ETENDER_SYNC_ENABLED=true
# Multi-source: allow-list of source ids (empty = all). Sources: ETENDER_SELECTION,
# ETENDER_TENDER, BIZNESXARID, UZMEDIMPEX_TENDER, UZMEDIMPEX_SELECTION, UZMEDIMPEX_MARKETING
ETENDER_SYNC_SOURCES=
# keep only medical lots (filter before saving/showing)
ETENDER_MEDICAL_ONLY=true
# gov.uz UzMedImpex news (api-portal.gov.uz; header code=<authority>, language=<lang>)
ETENDER_GOVUZ_ENABLED=true
ETENDER_GOVUZ_API_BASE=https://api-portal.gov.uz
ETENDER_GOVUZ_LANG=ru
# xarid.uzex.uz (anonymous)
ETENDER_XARID_ENABLED=true
ETENDER_XARID_API_BASE=https://xarid-api-purchase.uzex.uz
ETENDER_XARID_LANG=ru
# xt-xarid.uz (Hayot Birja, anonymous JSON-RPC)
ETENDER_XT_ENABLED=true
ETENDER_XT_API_BASE=https://api.xt-xarid.uz
ETENDER_XT_LANG=ru
ETENDER_SYNC_CRON=0 8,20 * * *
ETENDER_SYNC_TZ=Asia/Tashkent
ETENDER_SYNC_PAGE_SIZE=50
ETENDER_SYNC_MAX_PAGES=40
ETENDER_LIST_CACHE_TTL_MS=300000
# Публичный префикс для локально сохранённых файлов. Относительный —
# значит их отдаёт тот же origin, что и сайт (nginx/dev-server проксирует /uploads).
MEDIA_PUBLIC_URL=/uploads

# Секрет вебхука Telegram. Приходит в заголовке X-Telegram-Bot-Api-Secret-Token
# и подтверждает, что запрос действительно от Telegram: адрес /api/telegram/webhook
# публичный, и без проверки написать в служебную группу мог бы кто угодно.
# Значение произвольное, сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Куда ретранслировать копию каждого обновления от Telegram (прокси amoCRM).
# Telegram доставляет вебхук строго по одному адресу, поэтому «работает и бот,
# и amoCRM» достигается только ретрансляцией: принимаем мы, обрабатываем
# онбординг и следом отдаём копию сюда тем же телом. Пусто — выключено.
# Вид адреса: https://prx.amocrm.com/~external/hooks/telegram?t=<токен бота>&
# В нём вшит токен бота — поэтому значение живёт только здесь, не в git.
TELEGRAM_FORWARD_URL=
