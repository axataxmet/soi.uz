# ── App ──
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3456

# ── Database (Postgres) ──
# For local `npm run` against the Docker DB use localhost; inside Docker the host is `postgres`.
DATABASE_URL=postgresql://soi:soi_password@localhost:5432/soi?schema=public
POSTGRES_USER=soi
POSTGRES_PASSWORD=soi_password
POSTGRES_DB=soi
POSTGRES_PORT=5432

# ── JWT ──
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── S3 / MinIO ──
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=soi-media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=soi-media

# ── Seed (first superadmin) ──
SEED_ADMIN_EMAIL=admin@soi.uz
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── e-tender (UZEX): isolated schema/pool + daily sync ──
# Own Postgres schema; if unset it is derived from DATABASE_URL with ?schema=etender
ETENDER_DATABASE_URL=
ETENDER_API_BASE=https://apietender.uzex.uz
ETENDER_SYNC_ENABLED=true
ETENDER_SYNC_TYPES=1,2
ETENDER_SYNC_CRON=0 20 * * *
ETENDER_SYNC_TZ=Asia/Tashkent
ETENDER_SYNC_PAGE_SIZE=50
ETENDER_SYNC_MAX_PAGES=40
ETENDER_LIST_CACHE_TTL_MS=300000
