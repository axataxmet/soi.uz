// Isolated persistence for the e-tender (UZEX) module.
// Separate Prisma schema → separate generated client → separate connection pool,
// living in its OWN Postgres schema `etender` (via ETENDER_DATABASE_URL, same
// instance as the main app for now). This keeps tender read load off the main
// site's connection pool and makes extracting the module into its own service
// a matter of moving this folder and repointing one env var.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("ETENDER_DATABASE_URL")
}

enum EtenderSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model EtenderLot {
  id           String    @id @default(cuid())
  externalId   Int       @unique // upstream lot id (`id`)
  displayNo    String? // `display_no`
  typeId       Int // trade system / route :typeId (1, 2, …)
  name         String
  startDate    DateTime? // `start_date`
  endDate      DateTime? // `end_date`
  clarificDate DateTime? // `clarific_date`
  cost         Decimal?  @db.Decimal(24, 2)
  sellerId     Int? // `seller_id`
  sellerName   String? // `seller_name`
  sellerTin    String? // `seller_tin`
  regionName   String? // `region_name`
  districtName String? // `district_name`
  categoryName String? // `category_name`
  currencyId   Int? // `currency_id`
  currencyName String? // `currency_name`
  currencyCode String? // `currency_codeabc` (e.g. UZS)
  raw          Json // full original item, for fields we don't model yet
  active       Boolean   @default(true) // false once it leaves the open feed
  syncedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([typeId, active])
  @@index([endDate])
  @@map("etender_lots")
}

model EtenderSyncLog {
  id          String            @id @default(cuid())
  typeId      Int
  status      EtenderSyncStatus
  fetched     Int               @default(0) // items pulled from upstream
  upserted    Int               @default(0) // rows created or updated
  deactivated Int               @default(0) // rows marked inactive
  totalCount  Int? // `total_count` reported upstream
  durationMs  Int?
  error       String?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?

  @@index([typeId, startedAt])
  @@map("etender_sync_logs")
}
