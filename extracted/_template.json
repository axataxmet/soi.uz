ow:hidden;background:linear-gradient(118deg,#0e1f3a,#16407e);border-radius:24px;padding:42px 48px;display:flex;align-items:center;gap:40px;flex-wrap:wrap}\n.tender-band::after{content:\"\";position:absolute;right:-70px;top:-70px;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgba(54,150,220,.45),transparent 70%);filter:blur(30px)}\n.tb-tx{position:relative;z-index:2;flex:1;min-width:300px}\n.tb-badge{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.08em;background:rgba(255,255,255,.16);color:#cfe2ff;padding:5px 11px;border-radius:6px;margin-bottom:14px}\n.tender-band h3{font-size:27px;font-weight:800;color:#fff;letter-spacing:-.02em;margin:0 0 12px;line-height:1.18}\n.tender-band p{font-size:15.5px;color:rgba(255,255,255,.8);line-height:1.6;margin:0;max-width:560px}\n.tb-actions{position:relative;z-index:2;display:flex;flex-direction:column;gap:12px;align-items:stretch;min-width:230px}\n.btn-ghost-d{background:rgba(255,255,255,.08);color:#fff;border:1.5px solid rgba(255,255,255,.25);font-weight:700;border-radius:11px;padding:13px 22px;cursor:pointer;font-size:14.5px;font-family:inherit;transition:.15s}\n.btn-ghost-d:hover{background:rgba(255,255,255,.16)}\n.tb-dl{display:inline-flex;align-items:center;gap:8px;color:#cfe2ff;font-size:13.5px;font-weight:700;justify-content:center;padding-top:2px}\n.tb-dl:hover{color:#fff}\n[data-theme=\"dark\"] .equip-card{background:var(--surface);border-color:var(--line)}\n[data-theme=\"dark\"] .equip-ic{background:#16273f}\n@media(max-width:980px){.equip-grid{grid-template-columns:1fr 1fr}}\n@media(max-width:560px){.equip-grid{grid-template-columns:1fr}.tender-band{padding:32px 26px}.tender-band h3{font-size:22px}}\n\n/* ===== footer ===== */\n.foot{background:#0e1f3a;color:#9fb4cf;margin-top:64px}\n.qm-file{width:100%;font-size:13px;padding:9px 12px;border:1px dashed var(--line);border-radius:9px;background:var(--bg,#f5f8fc);cursor:pointer;color:var(--slate-600)}\n.qm-file-hint{font-size:11.5px;color:var(--slate-400);margin-top:5px}\n.qm-consent{display:flex;align-items:flex-start;gap:9px;font-size:12.5px;color:var(--slate-500);line-height:1.5;margin:4px 0 14px;cursor:pointer}\n.qm-consent input{margin-top:2px;flex-shrink:0}\n.foot.light{background:#eef3f9;color:var(--slate-600);border-top:1px solid var(--line)}\n.docs-onreq{display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding:24px;background:var(--bg,#f5f8fc);border:1px dashed var(--line);border-radius:14px}\n.docs-onreq .dor-ic{width:54px;height:54px;border-radius:12px;background:var(--surface);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--blue-600,#1a5fd0);flex-shrink:0}\n.docs-onreq .dor-tx{flex:1;min-width:220px}\n.docs-onreq .dor-t{font-size:15.5px;font-weight:700;margin-bottom:4px}\n.docs-onreq .dor-d{font-size:13.5px;color:var(--slate-500);line-height:1.5}\n.docs-foot-note{display:flex;align-items:center;gap:9px;margin-top:16px;padding:14px 16px;background:var(--bg,#f5f8fc);border-radius:10px;font-size:13px;color:var(--slate-500)}\n.docs-foot-note svg{color:var(--blue-600,#1a5fd0);flex-shrink:0}\n.foot-top{display:grid;grid-template-columns:1.5fr .9fr 1fr 1.15fr 1.2fr;gap:30px;padding:52px 0 36px}\n.foot .f-brand{display:flex;align-items:center;gap:11px;margin-bottom:16px}\n.foot .f-mark{height:42px;width:42px;display:block;flex-shrink:0}\n.foot .f-wordmark{font-size:18px;font-weight:800;letter-spacing:-.01em;color:#fff;white-space:nowrap}\n.foot .f-wordmark .ex{color:var(--cyan-500)}\n.foot.light .f-wordmark{color:var(--ink)}\n.foot .f-logo-img{height:40px;width:auto;display:block}\n.foot .f-logo{height:40px;border-radius:8px}\n.foot.light .f-name{color:var(--ink)}\n.foot.light .f-name .ex{color:var(--cyan-600)}\n.foot.light h5{color:var(--ink)}\n.foot.light p{color:var(--slate-600)}\n.foot.light ul a:hover{color:var(--blue-600)}\n.foot.light .foot-contact .fc-it svg{color:var(--blue-600)}\n.foot.light .foot-bot{border-top:1