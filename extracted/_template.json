;font-size:13.5px;font-weight:700;cursor:pointer;flex-shrink:0;transition:background .15s}\n.sb-cat:hover,.sb-cat.open{background:var(--blue-700)}\n.sb-cat svg{color:#fff}\n.sb-cats{display:flex;align-items:center;gap:2px}\n.sb-cats .nav-dd a{padding:7px 10px;border-radius:8px;font-size:13px;font-weight:600;color:var(--slate-600);white-space:nowrap;cursor:pointer}\n.sb-cats .nav-dd a:hover,.sb-cats .nav-dd a.dd-open{color:var(--blue-600);background:var(--bg)}\n.sb-cats .nav-dd a.on{color:var(--blue-700)}\n.sb-search{flex:1;min-width:120px;display:flex;align-items:center;gap:8px;height:38px;padding:0 14px;background:var(--bg-2);border:1px solid var(--line);border-radius:9px;color:var(--slate-400)}\n.sb-search input{flex:1;border:none;background:none;outline:none;font-size:14px;color:var(--ink);min-width:0}\n.sb-search:focus-within{border-color:var(--blue-400,#6ea8fe);background:var(--surface)}\n.sb-actions{display:flex;align-items:center;gap:4px;flex-shrink:0}\n.sb-ic{position:relative;width:40px;height:40px;display:flex;align-items:center;justify-content:center;border:none;background:none;border-radius:9px;color:var(--slate-600);cursor:pointer;transition:background .15s,color .15s}\n.sb-ic:hover{background:var(--bg);color:var(--blue-600)}\n.sb-ic.has{color:var(--blue-600)}\n.sb-cnt{position:absolute;top:4px;right:4px;min-width:16px;height:16px;padding:0 4px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;line-height:1;color:#fff;background:var(--cyan-500);border-radius:99px}\n.sb-div{width:1px;height:24px;background:var(--line);margin:0 4px}\n.sb-lang{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}\n.sb-lang button{border:none;background:none;padding:6px 8px;font-size:11.5px;font-weight:700;color:var(--slate-500);cursor:pointer;transition:background .12s,color .12s}\n.sb-lang button.on{background:var(--blue-600);color:#fff}\n.sb-lang button:not(.on):hover{background:var(--bg)}\n@media(max-width:1080px){.sb-cats{display:none}}\n@media(max-width:860px){.sticky-bar{display:none}}\n.nav-dd{display:inline-flex;align-items:center}\n.catmega{position:absolute;left:0;right:0;top:calc(100% + 8px);z-index:200;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:0 20px 50px rgba(9,24,48,.18);animation:navDdFade .16s ease}\n.catmega-inner{max-width:var(--maxw);margin:0 auto;padding:20px 24px}\n@keyframes navDdFade{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}\n.catmega-head{display:flex;align-items:center;gap:10px;padding-bottom:13px;margin-bottom:8px;border-bottom:1px solid var(--line)}\n.catmega-ic{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9px;background:var(--blue-50,#eaf2ff);color:var(--blue-600)}\n.catmega-title{font-size:15px;font-weight:800;color:var(--slate-900)}\n.catmega-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px 28px}\n.catmega-item{display:flex;align-items:flex-start;gap:7px;padding:9px 8px;font-size:13.5px;line-height:1.3;color:var(--slate-700);cursor:pointer;text-decoration:none;border-radius:8px;transition:background .12s,color .12s}\n.catmega-item>span{min-width:0;overflow-wrap:anywhere}\n.catmega-item:hover{background:var(--bg-2);color:var(--blue-600)}\n.catmega-item .cmi-chev{color:var(--slate-300);flex-shrink:0;margin-top:3px;transition:color .12s,transform .12s}\n.catmega-item:hover .cmi-chev{color:var(--blue-600);transform:translateX(2px)}\n.catmega-all{display:block;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);font-size:13.5px;font-weight:700;color:var(--blue-600);cursor:pointer;text-decoration:none}\n.catmega-all:hover{color:var(--blue-700)}\n.nav-links .nav-dd a.dd-open{color:var(--blue-700);background:var(--bg)}\n/* hover bridge: prevents flicker crossing the gap between label and dropdown */\n.catmega::before{content:\"\";position:absolute;top:-8px;left:0;right:0;height:8px}\n.catmega-grid+.catmega-all{margin-top:8px}\n@media(max-width:1100px){.catmega-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:680px){.catmega-grid{grid-template-columns:1fr}}\n/* ===== catalog: direction sections + product-group tiles ===== */\n.cat-sections{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}\n.cat-sec-chip{padding:7px 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:13px;font-weight:600;color:var(--slate-600);cursor:pointer;transition:all .13s}\n.cat-sec-chip:hover{border-color:var(--blue-400);color:var(--blue-600)}\n.cat-sec-chip.on{background:var(--blue-600);border-color:var(--blue-600);color:#fff}\n.cat-groups{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px}\n.cat-group-tile{display:flex;align-items:center;gap:11px;padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:var(--surface);text-align:left;cursor:pointer;transition:border-color .14s,box-shadow .14s,transform .14s}\n.cat-group-tile:hover{border-color:var(--blue-400);box-shadow:0 6px 20px rgba(9,24,48,.08);transform:translateY(-2px)}\n.cat-group-tile .cgt-ic{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:var(--blue-50,#eaf2ff);color:var(--blue-600);flex-shrink:0}\n.cat-group-tile .cgt-name{flex:1;min-width:0;font-size:14px;font-weight:600;color:var(--slate-800);line-height:1.3}\n.cat-group-tile .cgt-chev{color:var(--slate-300);flex-shrink:0;transition:color .14s,transform .14s}\n.cat-group-tile:hover .cgt-chev{color:var(--blue-600);transform:translateX(2px)}\n/* ===== full-width grouped directions mega ===== */\n.mega-cols{max-width:var(--maxw);margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:0 28px;padding:26px 24px 22px}\n.mega-col{min-width:0}\n.mega-col-h{font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--blue-700);padding-bottom:10px;margin-bottom:6px;border-bottom:1px solid var(--line)}\n.mega-col-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px}\n.mega-glink{display:flex;align-items:center;gap:7px;padding:8px 10px;border-radius:8px;font-size:13.5px;font-weight:600;color:var(--slate-700);cursor:pointer;text-decoration:none;transition:background .13s,color .13s}\n.mega-glink:hover{background:var(--bg-2);color:var(--blue-600)}\n.mega-glink .mgl-chev{color:var(--slate-300);flex-shrink:0;transition:color .13s,transform .13s}\n.mega-glink:hover .mgl-chev{color:var(--blue-600);transform:translateX(2px)}\n.mega-foot{max-width:var(--maxw);margin:0 auto;display:flex;align-items:center;gap:16px;padding:16px 24px;border-top:1px solid var(--line);background:linear-gradient(115deg,#eaf3fd,#dbeafb)}\n.mega-foot-txt{display:flex;align-items:center;gap:10px;font-size:14.5px;font-weight:700;color:var(--ink)}\n.mega-foot .btn{margin-left:auto}\n@media(max-width:1100px){.mega-cols{grid-template-columns:repeat(2,1fr);gap:8px 24px}}\n@media(max-width:680px){.mega-cols{grid-template-columns:1fr}}\n.doc-overlay{position:fixed;inset:0;z-index:4000;background:rgba(9,24,48,.62);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:32px;animation:docFade .18s ease}\n@keyframes docFade{from{opacity:0}to{opacity:1}}\n.doc-modal{width:min(920px,100%);height:min(90vh,100%);background:var(--surface);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 70px rgba(9,24,48,.4);animation:docPop .2s cubic-bezier(.2,.8,.3,1)}\n@keyframes docPop{from{transform:translateY(14px) scale(.98);opacity:0}to{transform:none;opacity:1}}\n.doc-modal-bar{display:flex;align-items:center;gap:14px;padding:13px 16px;border-bottom:1px solid var(--line);flex-shrink:0}\n.doc-modal-title{flex:1;font-size:14px;font-weight:700;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.doc-modal-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}\n.doc-modal-dl{font-size:13px;font-weight:700;color:var(--blue-600);text-decoration:none;padding:7px 14px;border:1.5px solid var(--blue-600);border-radius:9px;transition:background .15s,color .15s}\n.doc-modal-dl:hover{background:var(--blue-600);color:#fff}\n.doc-modal-close{width:34px;height:34px;border:none;background:var(--bg-2);border-radius:9px;font-size:22px;line-height:1;color:var(--slate-600);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s}\n.doc-modal-close:hover{background:var(--line)}\n.doc-modal-body{flex:1;position:relative;background:var(--bg-2);display:flex;align-items:center;justify-content:center;min-height:0}\n.doc-modal-body iframe,.doc-modal-body embed{width:100%;height:100%;border:0}\n.doc-canvas{display:block;max-width:100%;height:auto;margin:0 auto}\n.doc-modal-body{overflow-y:auto;align-items:flex-start;padding:16px}\n.doc-modal-prev,.doc-modal-next{width:30px;height:30px;border:none;background:var(--bg-2);border-radius:8px;font-size:16px;cursor:pointer;color:var(--slate-600);display:flex;align-items:center;justify-content:center;transition:background .15s}\n.doc-modal-prev:hover,.doc-modal-next:hover{background:var(--line)}\n.doc-modal-page{font-size:13px;color:var(--slate-500);min-width:50px;text-align:center}\n.doc-modal-spin{width:34px;height:34px;border:3px solid var(--line);border-top-color:var(--blue-600);border-radius:50%;animation:spin .8s linear infinite}\n.doc-modal-err{text-align:center;font-size:14px;color:var(--slate-600);line-height:1.7}\n.doc-modal-err a{color:var(--blue-600);font-weight:700}\n@media(max-width:620px){.doc-overlay{padding:0}.doc-modal{width:100%;height:100%;border-radius:0}.doc-modal-dl{padding:6px 10px}}\n\n/* ===== embed mode (catalog inside soi.uz host shell) ===== */\n/* unified header (variant 3): the corp host header provides logo + search + lang/theme + cart.\n   So inside the embedded catalog we hide its own utility bar AND its commercial header,\n   keeping only the category Nav as the \"middle row\". */\n.embed .ubar{display:none!important}\n.embed .head{display:none!important}\n.embed .sb-brand{display:none!important}\n/* seamless: catalog reads as a section of soi.uz, not a separate site */\n.embed{background:var(--bg)}\n.embed body{background:var(--bg)}\n.embed .sticky-bar{display:none!important}\n/* category nav becomes the catalog's middle row, sits right under the host header */\n.embed .nav{position:static!important;box-shadow:none!important;border-top:1px solid var(--line)}\n/* breadcrumbs (catalog section of soi.uz) */\n.crumbs{background:var(--surface);border-bottom:1px solid var(--line)}\n.crumbs .wrap{display:flex;align-items:center;gap:9px;padding-top:11px;padding-bottom:11px;font-size:13px;flex-wrap:wrap}\n/* hide local .crumb divs in embed mode — global <Breadcrumbs> handles them */\n.embed .crumb{display:none!important}\n.crumb-sep{color:var(--slate-400)}\n.crumb-lnk{color:var(--slate-600);font-weight:600;cursor:pointer;transition:color .15s}\n.crumb-lnk:hover{color:var(--blue-600)}\n.crumb-cur{color:var(--ink);font-weight:700}\n[data-theme=\"dark\"] .crumbs{background:var(--surface);border-color:var(--line)}\n</style>\n<style>/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 300;\n  font-display: swap;\n  src: url(\"f0800936-12b1-4a0a-a77c-4ae2b172bf98\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 300;\n  font-display: swap;\n  src: url(\"2865eede-8439-42b2-bdb1-0e0d2be7dc62\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* lati