(--slate-400,#9aa9bf);font-weight:500}\n.z-corp .co-search-btn{flex-shrink:0;height:32px;padding:0 16px;border:none;border-radius:8px;background:var(--blue-600,#0E4AC6);color:#fff;font-size:13.5px;font-weight:700;cursor:pointer;font-family:\"DM Sans\",sans-serif;transition:background .15s}\n.z-corp .co-search-btn:hover{background:#0c3fb8}\n\n.z-corp .co-actions{display:flex;align-items:center;gap:4px;flex-shrink:0}\n.z-corp .co-act{position:relative;width:42px;height:42px;display:flex;align-items:center;justify-content:center;border:none;background:transparent;border-radius:10px;color:var(--slate-600,#56657d);cursor:pointer;transition:background .14s,color .14s}\n.z-corp .co-act:hover{background:var(--blue-50,#eaf2ff);color:var(--blue-600,#0E4AC6)}\n.z-corp .co-act:focus-visible{outline:2px solid var(--blue-500,#2b72e3);outline-offset:2px}\n.z-corp .co-act-cart{color:var(--blue-600,#0E4AC6)}\n.z-corp .co-badge{position:absolute;top:3px;right:2px;min-width:17px;height:17px;padding:0 4px;display:flex;align-items:center;justify-content:center;\n  background:var(--blue-600,#0E4AC6);color:#fff;font-size:10.5px;font-weight:800;border-radius:9px;line-height:1;font-family:\"DM Sans\",sans-serif}\n.z-corp .co-act-cart .co-badge{background:#e8553a}\n\n/* second nav row — corp sections, sits under the unified top bar */\n.z-corp .nav-row2{position:sticky;top:74px;z-index:99;background:var(--surface,#fff);border-bottom:1px solid var(--line-soft,#e3eaf3)}\n.z-corp .nav-row2 .wrap{display:flex;align-items:center;height:48px}\n.z-corp .nav-row2 .nav-links{margin-left:0}\n.z-corp .nav.scrolled + .nav-row2{box-shadow:0 6px 18px rgba(9,24,48,.05)}\n[data-theme=\"dark\"] .z-corp .nav-row2{background:#0c1726;border-color:#1c2c44}\n[data-theme=\"dark\"] .z-corp .co-search{background:#0c1726;border-color:#22344e}\n[data-theme=\"dark\"] .z-corp .co-search:focus-within{background:#0f1f36}\n[data-theme=\"dark\"] .z-corp .co-act:hover{background:#16273f}\n.z-corp .co-search-m{display:none}\n\n/* ===== combined catalog sticky bar (appears on scroll, catalog only) ===== */\n.z-corp .cat-sticky{position:fixed;top:0;left:0;right:0;z-index:120;background:var(--surface,#fff);\n  border-bottom:1px solid var(--line-soft,#e3eaf3);box-shadow:0 6px 22px rgba(9,24,48,.10);\n  transform:translateY(-100%);opacity:0;transition:transform .3s cubic-bezier(.16,1,.3,1),opacity .2s;pointer-events:none}\n.z-corp .cat-sticky.show{transform:translateY(0);opacity:1;pointer-events:auto}\n.z-corp .cat-sticky .wrap{display:flex;align-items:center;gap:14px;height:60px}\n.z-corp .cs-logo{width:36px;height:36px;flex-shrink:0;cursor:pointer}\n.z-corp .cs-menu{flex-shrink:0;display:flex;align-items:center;gap:7px;height:38px;padding:0 15px;border:none;border-radius:9px;\n  background:linear-gradient(135deg,var(--blue-600,#0E4AC6),var(--cyan-500,#1aa6d6));color:#fff;font-size:13.5px;font-weight:700;\n  cursor:pointer;font-family:\"DM Sans\",sans-serif;white-space:nowrap}\n.z-corp .cs-menu:hover{filter:brightness(1.05)}\n.z-corp .cs-links{display:flex;gap:2px;flex-shrink:0}\n.z-corp .cs-links a{padding:7px 12px;border-radius:8px;font-size:13.5px;font-weight:600;color:var(--slate-600,#56657d);white-space:nowrap;cursor:pointer;transition:.14s}\n.z-corp .cs-links a:hover{color:var(--blue-600,#0E4AC6);background:var(--blue-50,#eaf2ff)}\n.z-corp .cs-search{flex:1;min-width:90px;display:flex;align-items:center;gap:8px;height:38px;padding:0 14px;\n  background:var(--bg,#f3f7fc);border:1.5px solid var(--line-soft,#e3eaf3);border-radius:9px;color:var(--slate-500,#7587a0);transition:border-color .16s,background .16s}\n.z-corp .cs-search:focus-within{border-color:var(--blue-500,#2b72e3);background:var(--surface,#fff)}\n.z-corp .cs-search input{flex:1;min-width:0;border:none;background:transparent;outline:none;font-size:14px;color:var(--ink);font-family:\"DM Sans\",sans-serif}\n.z-corp .cs-search input::placeholder{color:var(--slate-400,#9aa9bf)}\n.z-corp .cat-sticky .co-actions{flex-shrink:0;gap:2px}\n[data-theme=\"dark\"] .z-corp .cat-sticky{background:#0c1726;border-color:#1c2c44}\n[data-theme=\"dark\"] .z-corp .cs-search{background:#0c1726;border-color:#22344e}\n[data-theme=\"dark\"] .z-corp .cs-links a:hover{background:#16273f}\n@media(max-width:1140px){.z-corp .cs-links a:nth-child(n+4){display:none}}\n@media(max-width:920px){.z-corp .cat-sticky{display:none}}\n\n@media(max-width:1180px){\n  .z-corp .co-search-btn span{display:none}\n}\n@media(max-width:980px){\n  .z-corp .co-search,.z-corp .co-actions{display:none}\n  .z-corp .nav-row2{display:none}\n  .z-corp .co-search-m{display:flex;flex:none;width:auto;margin:6px 0 14px}\n  .z-corp .co-search-m input{width:100%}\n}\n</style>\n<style>/* ===== UzMedEx design system ===== */\n:root{\n  --navy-900:#071A33; --navy-850:#0b1f3a; --navy-800:#0d2650; --navy-700:#123565;\n  --blue-700:#0a3a9c; --blue-600:#0E4AC6; --blue-500:#2b72e3; --blue-400:#4d8eee;\n  --cyan-600:#0d96be; --cyan-500:#14A7E5; --cyan-400:#36c5ec;\n  --ink:#102033; --slate-700:#2b3d52; --slate-600:#455669; --slate-500:#60738A; --slate-400:#8fa0b2;\n  --line:#D9E3F0; --line-soft:#ecf0f5; --bg:#F5F8FC; --bg-2:#edf2f8; --surface:#ffffff;\n  --success:#0f9960; --success-bg:#e6f5ee; --amber:#b87213; --amber-bg:#faf0dc; --violet:#6454d4;\n  --r-sm:8px; --r:12px; --r-lg:16px; --r-xl:24px;\n  --sh-sm:0 1px 2px rgba(11,31,58,.05), 0 1px 4px rgba(11,31,58,.04);\n  --sh:0 2px 8px rgba(11,31,58,.06), 0 4px 16px rgba(11,31,58,.05);\n  --sh-lg:0 8px 32px rgba(9,24,48,.1), 0 2px 8px rgba(9,24,48,.06);\n  --sh-xl:0 20px 60px rgba(9,24,48,.14), 0 6px 20px rgba(9,24,48,.07);\n  --maxw:1280px;\n  --grad-brand:linear-gradient(125deg,#0E4AC6 0%,#15aed8 100%);\n  --grad-hero:linear-gradient(160deg,#f8fbff 0%,#ebf3fd 45%,#e3eef9 100%);\n  --font:\"Manrope\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;\n  --mono:\"Geist Mono\",\"JetBrains Mono\",ui-monospace,monospace;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;overflow-x:hidden;max-width:100%}\nbody{font-family:var(--font);background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.5}\n.mono{font-family:var(--mono);font-feature-settings:\"tnum\"}\n\n/* ===== a11y: keyboard focus ring ===== */\n:focus-visible{outline:2.5px solid var(--blue-500);outline-offset:2px;border-radius:6px}\na:focus-visible,button:focus-visible,.card:focus-visible,.cat-tile:focus-visible,\ninput:focus-visible,textarea:focus-visible,select:focus-visible,[tabindex]:focus-visible{\n  outline:2.5px solid var(--blue-500);outline-offset:2px}\n.search:focus-within{outline:none}\n\n/* ===== card cascade entrance ===== */\n@media (prefers-reduced-motion: no-preference){\n  .cat-grid-p > .card,.grid-4 > .card{animation:cardCascade .5s cubic-bezier(.16,1,.3,1) backwards}\n  .cat-grid-p > .card:nth-child(1),.grid-4 > .card:nth-child(1){animation-delay:.03s}\n  .cat-grid-p > .card:nth-child(2),.grid-4 > .card:nth-child(2){animation-delay:.07s}\n  .cat-grid-p > .card:nth-child(3),.grid-4 > .card:nth-child(3){animation-delay:.11s}\n  .cat-grid-p > .card:nth-child(4),.grid-4 > .card:nth-child(4){animation-delay:.15s}\n  .cat-grid-p > .card:nth-child(5){animation-delay:.19s}\n  .cat-grid-p > .card:nth-child(6){animation-delay:.23s}\n  .cat-grid-p > .card:nth-child(7){animation-delay:.27s}\n  .cat-grid-p > .card:nth-child(8){animation-delay:.31s}\n  .cat-grid-p > .card:nth-child(9){animation-delay:.35s}\n  .cat-grid-p > .card:nth-child(n+10){animation-delay:.38s}\n}\n/* base stays fully visible; cascade only slides + softly fades so cards are\n   never left invisible if the animation timeline is throttled/frozen */\n@keyframes cardCascade{from{opacity:.25;transform:translateY(16px)}to{opacity:1;transform:none}}\nbutton{font-family:inherit;cursor:pointer;border:none;background:none}\ninput,textarea,select{font-family:inherit}\na{color:inherit;text-decoration:none}\nimg{display:block;max-width:100%}\n.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}\n.app{min-height:100vh;display:flex;flex-direction:column}\n.app-main{flex:1}\n::selection{background:var(--cyan-500);color:#fff}\n\n/* ===== utility / top bar ===== */\n.ubar{background:var(--surface);color:var(--slate-600);font-size:12.5px;border-bottom:1px solid var(--line)}\n.ubar .wrap{display:flex;align-items:center;gap:18px;height:36px}\n.ubar a,.ubar-info span{white-space:nowrap}\n.ubar-links,.ubar-info,.ubar-right,.lang,.ubar-acct{flex-shrink:0}\n.ubar-links{display:flex;gap:18px;align-items:center}\n.ubar a:hover{color:var(--blue-600)}\n.ubar-info{display:flex;align-items:center;gap:7px;color:var(--slate-500)}\n.ubar-info svg{color:var(--cyan-400)}\n.ubar-spacer{flex:1}\n.ubar-right{display:flex;align-items:center;gap:18px}\n.lang{display:inline-flex;background:#fff;border:1px solid var(--line);border-radius:999px;padding:2px;gap:2px}\n.lang button{color:var(--slate-500);font-size:12px;font-weight:700;padding:3px 11px;border-radius:999px;letter-spacing:.04em}\n.lang button.on{background:var(--blue-600);color:#fff}\n.ubar-acct{display:flex;align-items:center;gap:7px;color:var(--slate-600)}\n.ubar-acct:hover{color:var(--blue-600)}\n\n/* ===== header / search ===== */\n.head{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:60;box-shadow:0 1px 0 var(--line),0 4px 16px rgba(9,24,48,.04)}\n.head .wrap{display:flex;align-items:center;gap:24px;height:80px}\n.brand{display:flex;align-items:center;gap:0;flex-shrink:0}\n.brand-mark{height:44px;width:44px;display:block;flex-shrink:0}\n.sb-mark{height:38px;width:38px}\n.brand-cube{height:48px}\n.sb-brand .brand-cube{height:38px}\n.brand-logo-img.is-dark{display:none}\n[data-theme=\"dark\"] .brand-logo-img.is-light{display:none}\n[data-theme=\"dark\"] .brand-logo-img.is-dark{display:block}\n.brand-logo{height:46px;width:auto;border-radius:9px}\n.brand-tx{display:flex;flex-direction:column;line-height:1}\n.brand-name{font-weight:800;font-size:17px;letter-spacing:-.01em;white-space:nowrap}\n.brand-name .ex{color:var(--cyan-500)}\n.brand-tag{font-size:10.5px;color:var(--slate-500);font-weight:600;letter-spacing:.02em;margin-top:3px}\n.search{flex:1;display:flex;align-items:center;background:var(--bg);border:1.5px solid var(--line);border-radius:var(--r);height:48px;padding:0 6px 0 16px;transition:.15s}\n.search:focus-within{background:#fff;border-color:var(--blue-500);box-shadow:0 0 0 3px rgba(23,87,200,.1)}\n.search svg{color:var(--slate-500);flex-shrink:0}\n.search input{flex:1;border:none;background:none;outline:none;font-size:15px;padding:0 12px;color:var(--ink)}\n.search input::placeholder{color:var(--slate-400)}\n.search-btn{background:var(--grad-brand);color:#fff;font-weight:700;font-size:14px;height:36px;padding:0 20px;border-radius:8px;flex-shrink:0;letter-spacing:.01em}\n.head-actions{display:flex;align-items:center;gap:6px;flex-shrink:0}\n.hact{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:64px;height:64px;color:var(--slate-400);border-radius:12px;font-size:10.5px;font-weight:700;transition:.15s;letter-spacing:.02em;flex-shrink:0}\n.hact:hover{color:var(--blue-600);background:var(--bg-2)}\n.hact.has-items{color:var(--blue-600)}\n.hact.has-items:hover{color:var(--blue-700)}\n.hact .cnt{position:absolute;top:8px;right:4px;min-width:18px;height:18px;padding:0 4px;background:var(--blue-600);color:#fff;border-radius:999px;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono);border:2px solid var(--surface);line-height:1;pointer-events:none}\n\n/* ===== nav / catalog button ===== */\n.nav{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:80px;z-index:55}\n.nav .wrap{display:flex;align-items:center;gap:6px;height:52px;position:relative}\n.cat-btn{display:flex;align-items:center;gap:9px;background:var(--grad-brand);color:#fff;font-weight:700;font-size:14px;height:40px;padding:0 18px;border-radius:10px;box-shadow:0 2px 10px rgba(23,87,200,.2);white-space:nowrap}\n.cat-btn svg{color:#fff}\n.cat-btn.open{background:var(--blue-700)}\n.nav-links{display:flex;gap:2px;margin-left:4px}\n.nav-links a{padding:7px 12px;border-radius:8px;font-size:13.5px;font-weight:600;color:var(--slate-600);white-space:nowrap}\n.nav-links a:hover{color:var(--blue-600);background:var(--bg)}\n.nav-links a.accent{color:var(--cyan-600)}\n.ubar-links a.ubar-tenders{display:inline-flex;align-items:center;gap:6px;color:var(--cyan-600);font-weight:700}\n.ubar-badge{font-size:9px;font-weight:800;letter-spacing:.03em;line-height:1;color:#fff;background:linear-gradient(120deg,var(--blue-600),var(--cyan-500));padding:2px 5px;border-radius:4px;text-transform:uppercase}\n.nav-links a.nav-tenders{display:inline-flex;align-items:center;gap:7px;color:var(--cyan-600);font-weight:700}\n.nav-links a.nav-tenders:hover{background:#e9f8fd;color:var(--cyan-600)}\n.nav-badge{font-size:9.5px;font-weight:800;letter-spacing:.04em;line-height:1;color:#fff;background:linear-gradient(120deg,var(--blue-600),var(--cyan-500));padding:3px 5px;border-radius:5px;text-transform:uppercase}\n.nav-spacer{flex:1}\n/* \"Ещё\" dropdown */\n.nav-more-wrap{position:relative;display:inline-flex}\n.nav-more-btn{display:inline-flex;align-items:center;gap:5px;padding:7px 12px;border-radius:8px;font-size:13.5px;font-weight:600;color:var(--slate-600);background:none;border:none;cursor:pointer;white-space:nowrap;transition:color .14s,background .14s}\n.nav-more-btn:hover,.nav-more-btn.open{color:var(--blue-600);background:var(--bg)}\n.nav-more-btn:focus-visible{outline:2px solid var(--blue-400);outline-offset:2px}\n.nav-more-dd{position:absolute;top:calc(100% + 6px);left:0;z-index:300;min-width:180px;background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 36px rgba(9,24,48,.13);padding:6px;animation:navDdFade .15s ease}\n.nav-more-item{display:block;width:100%;text-align:left;padding:9px 14px;border-radius:8px;border:none;background:none;font-size:14px;font-weight:600;color:var(--slate-600);cursor:pointer;transition:color .12s,background .12s}\n.nav-more-item:hover{color:var(--blue-600);background:var(--bg)}\n.nav-more-item.on{color:var(--blue-700);background:var(--blue-50)}\n.nav-more-item:focus-visible{outline:2px solid var(--blue-400);outline-offset:-2px}\n/* active states for main nav links */\n.nav-links a:focus-visible{outline:2px solid var(--blue-400);outline-offset:2px}\n.nav-links a:active{transform:scale(.96)}\n\n/* ===== mega menu ===== */\n.mega-ov{position:fixed;inset:0;background:rgba(9,24,48,.28);z-index:90;animation:fade .15s}\n.mega{position:absolute;left:0;right:0;top:0;margin:0 auto;max-width:var(--maxw);max-height:100%;overflow-y:auto;background:#fff;box-shadow:0 24px 60px rgba(9,24,48,.12),0 4px 12px rgba(9,24,48,.06);border-radius:0 0 16px 16px}\n.mega-inner{max-width:var(--maxw);margin:0 auto;display:grid;grid-template-columns:300px 1fr;min-height:360px}\n.mega-list{padding:16px 12px;border-right:1px solid var(--line);background:var(--bg)}\n.mega-list-scroll{max-height:440px;overflow-y:auto}\n.mega-subs{max-height:300px;overflow-y:auto}\n.mega-li{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:10px;cursor:pointer;color:var(--slate-700);font-weight:600;font-size:14px}\n.mega-li .mli-ic{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid var(--line);color:var(--blue-600);flex-shrink:0}\n.mega-li:hover,.mega-li.on{background:#fff;color:var(--blue-700);box-shadow:var(--sh-sm)}\n.mega-li.on .mli-ic{background:var(--grad-brand);color:#fff;border-color:transparent}\n.mega-li .chev{margin-left:auto;color:var(--slate-400)}\n.mega-panel{padding:26px 32px}\n.mega-panel h4{margin:0 0 5px;font-size:18px;font-weight:800}\n.mega-panel .mp-sub{color:var(--slate-500);font-size:13px;margin-bottom:20px}\n.mega-subs{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 22px;max-width:600px}\n.mega-sub{display:flex;align-items:center;justify-content:space-between;padding:10px 13px;border-radius:9px;color:var(--slate-700);font-weight:600;font-size:13.5px;border:1px solid transparent}\n.mega-sub:hover{background:var(--bg);border-color:var(--line);color:var(--blue-700)}\n.mega-sub .ct{font-family:var(--mono);font-size:11.5px;color:var(--slate-400)}\n.mega-cta{margin-top:22px;display:flex;align-items:center;gap:13px;background:linear-gradient(115deg,#eaf3fd,#dbeafb);border:1px solid #d0e4f8;color:var(--ink);border-radius:14px;padding:16px 20px;max-width:600px}\n.mega-cta .mc-t{font-weight:700}\n.mega-cta .mc-d{font-size:13px;color:var(--slate-500)}\n.mega-cta .btn{margin-left:auto}\n@keyframes fade{from{opacity:0}to{opacity:1}}\n\n/* ===== buttons ===== */\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:700;font-size:14px;height:44px;padding:0 22px;border-radius:10px;transition:.14s;white-space:nowrap;letter-spacing:.01em}\n.btn svg{flex-shrink:0}\n.btn-primary{background:var(--grad-brand);color:#fff;box-shadow:0 4px 14px rgba(23,87,200,.25)}\n.btn-primary:hover{filter:brightness(1.05);transform:translateY(-1px);box-shadow:0 6px 20px rgba(23,87,200,.32)}\n.btn-dark{background:var(--navy-850);color:#fff}\n.btn-dark:hover{background:var(--navy-700)}\n.btn-ghost{background:#fff;color:var(--ink);border:1.5px solid var(--line)}\n.btn-ghost:hover{border-color:var(--blue-400);color:var(--blue-600);background:var(--bg)}\n.btn-cyan{background:var(--cyan-500);color:#03202e}\n.btn-cyan:hover{background:var(--cyan-400)}\n.btn-lg{height:52px;font-size:15px;padding:0 28px}\n.btn-block{width:100%}\n.btn-light{background:rgba(255,255,255,.14);color:#fff;border:1.5px solid rgba(255,255,255,.22)}\n.btn-light:hover{background:rgba(255,255,255,.22)}\n\n/* ===== PREMIUM MICRO-DETAILS ===== */\n/* tactile press feedback on all interactive controls */\n.btn{transition:transform .14s cubic-bezier(.16,1,.3,1),box-shadow .18s,filter .18s,background .18s,border-color .18s}\n.btn:active{transform:translateY(0) scale(.97)}\n/* ===== universal disabled + loading states (crit. 10) ===== */\n.btn:disabled,.btn[disabled],.btn-buy:disabled,.pdp-icact:disabled{opacity:.5;cursor:not-allowed;filter:grayscale(.2);transform:none!important;box-shadow:none!important;pointer-events:none}\n.btn.is-loading,.btn[aria-busy=\"true\"]{color:transparent!important;pointer-events:none;position:relative}\n.btn.is-loading::after,.btn[aria-busy=\"true\"]::after{content:\"\";position:absolute;top:50%;left:50%;width:17px;height:17px;margin:-8.5px 0 0 -8.5px;border-radius:50%;border:2.5px solid rgba(255,255,255,.45);border-top-color:#fff;animation:btnspin .6s linear infinite}\n.btn-buy.is-loading::after,.btn-ghost.is-loading::after,.btn-white.is-loading::after{border-color:rgba(23,87,200,.3);border-top-color:var(--blue-600)}\n@keyframes btnspin{to{transform:rotate(360deg)}}\n/* form field error state */\n.field input.invalid,.field textarea.invalid,.field input:invalid:not(:placeholder-shown),.hf-input.invalid{border-color:var(--danger,#d6453a)!important;box-shadow:0 0 0 3px rgba(214,69,58,.12)!important}\n.field-err{display:flex;align-items:center;gap:5px;font-size:12.5px;color:var(--danger,#d6453a);font-weight:600;margin-top:6px}\n.field-err::before{content:\"!\";display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;background:var(--danger,#d6453a);color:#fff;font-size:10px;font-weight:800;flex-shrink:0}\n.btn-primary:active{filter:brightness(.98);box-shadow:0 2px 8px rgba(23,87,200,.22)}\n.btn-buy:active,.tool:active,.pdp-icact:active,.hact:active,.flt-trigger:active,.nc:active,.brand-chip:active{transform:scale(.95)}\n.cat-btn{transition:transform .14s cubic-bezier(.16,1,.3,1),background .18s,box-shadow .18s}\n.cat-btn:active{transform:scale(.97)}\n/* primary CTA: a touch more presence + animated sheen on hover */\n.btn-primary{position:relative;overflow:hidden}\n.btn-primary::before{content:\"\";position:absolute;top:0;left:-120%;width:60%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.28),transparent);transform:skewX(-18deg);transition:left .55s cubic-bezier(.16,1,.3,1);pointer-events:none}\n.btn-primary:hover::before{left:140%}\n/* product card: gentle image zoom + smoother lift */\n.card{transition:transform .22s cubic-bezier(.16,1,.3,1),box-shadow .22s,border-color .22s}\n.card .card-media .ph{transition:transform .4s cubic-bezier(.16,1,.3,1)}\n.card:hover .card-media .ph{transform:scale(1.045)}\n/* category tile icon + lift easing */\n.cat-tile,.hc-tile,.brand-chip,.dir-card{transition:transform .2s cubic-bezier(.16,1,.3,1),box-shadow .2s,border-color .2s}\n/* keyboard accessibility: visible focus ring on every interactive element */\na:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.chk:focus-visible,.card-title:focus-visible{outline:2px solid var(--blue-500);outline-offset:2px;border-radius:6px}\n.btn:focus-visible,.btn-primary:focus-visible{outline:2px solid var(--blue-700);outline-offset:3px}\n/* sticky header: deepen shadow once the page is scrolled */\n.head{transition:box-shadow .25s ease,background .25s ease}\n.head.scrolled{box-shadow:0 1px 0 var(--line),0 8px 28px rgba(9,24,48,.1)}\n/* active nav link highlight */\n.nav-links a.on{background:var(--bg-2);color:var(--blue-700);font-weight:700}\n\n/* ===== badges / stock / price ===== */\n.bdg{display:inline-flex;align-items:center;font-size:11px;font-weight:800;letter-spacing:.03em;text-transform:uppercase;padding:4px 9px;border-radius:6px;color:#fff}\n.bdg-hit{background:var(--blue-600)}\n.bdg-new{background:var(--cyan-500);color:#052232}\n.bdg-sale{background:#e0492f}\n.stk{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700}\n.stk-dot{width:7px;height:7px;border-radius:999px}\n.stk-in{color:var(--success)}.stk-in .stk-dot{background:var(--success)}\n.stk-order{color:var(--amber)}.stk-order .stk-dot{background:var(--amber)}\n.stk-pre{color:var(--slate-500)}.stk-pre .stk-dot{background:var(--slate-400)}\n.price-now{font-weight:800;color:var(--ink);letter-spacing:-.01em;white-space:nowrap}\n.price-cur{font-weight:600;color:var(--slate-500);font-size:.7em}\n.price-old{color:var(--slate-400);text-decoration:line-through;font-size:13px;margin-top:2px}\n.price-sm .price-now{font-size:18px}\n.price-md .price-now{font-size:22px}\n.price-lg .price-now{font-size:32px}\n\n/* ===== qty stepper ===== */\n.qty{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:10px;overflow:hidden;background:#fff}\n.qty button{width:40px;height:42px;display:flex;align-items:center;justify-content:center;color:var(--slate-600)}\n.qty button:hover{background:var(--bg-2);color:var(--blue-600)}\n.qty input{width:46px;height:42px;text-align:center;border:none;outline:none;font-weight:700;font-size:15px;font-family:var(--mono)}\n.qty-sm button{width:34px;height:36px}.qty-sm input{width:38px;height:36px;font-size:14px}\n\n/* ===== placeholder ===== */\n.ph{position:relative;width:100%;aspect-ratio:4/3;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center}\n.ph-big{aspect-ratio:1/1}\n.ph-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(20,58,107,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(20,58,107,.05) 1px,transparent 1px);background-size:22px 22px;opacity:.7}\n.ph-glyph{position:relative;opacity:.9;filter:drop-shadow(0 4px 8px rgba(14,42,82,.1))}\n.ph-photo img{width:100%;height:100%;object-fit:contain;display:block}\n.ph-meta{position:absolute;left:12px;right:12px;bottom:11px;display:flex;align-items:center;justify-content:space-between;gap:8px}\n.ph-brand{font-size:11px;font-weight:800;color:var(--slate-600);background:rgba(255,255,255,.78);padding:3px 8px;border-radius:6px;backdrop-filter:blur(4px)}\n.ph-type{font-size:10.5px;color:var(--slate-500);background:rgba(255,255,255,.6);padding:3px 7px;border-radius:6px}\n\n/* ===== product card ===== */\n.card{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:10px;display:flex;flex-direction:column;transition:.18s}\n.card:hover{box-shadow:var(--sh-xl);border-color:rgba(23,87,200,.12);transform:translateY(-4px)}\n.card-badges{position:absolute;top:18px;left:18px;z-index:2;display:flex;gap:6px}\n.card-tools{position:absolute;top:16px;right:16px;z-index:2;display:flex;flex-direction:column;gap:6px;opacity:0;transform:translateX(6px);transition:.16s}\n.card:hover .card-tools{opacity:1;transform:none}\n/* touch devices: no hover → always show tools so wishlist/compare are reachable */\n@media (hover:none){.card-tools{opacity:1;transform:none}}\n.tool{width:36px;height:36px;border-radius:9px;background:#fff;border:1px solid var(--line);color:var(--slate-600);display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-sm)}\n.tool:hover{color:var(--blue-600);border-color:var(--blue-500)}\n.tool.on{background:var(--blue-600);color:#fff;border-color:transparent}\n.card-media{cursor:pointer}\n.card-body{display:flex;flex-direction:column;gap:9px;padding:14px 6px 6px}\n.card-meta{display:flex;align-items:center;justify-content:space-between}\n.card-sku{font-size:11.5px;color:var(--slate-400)}\n.card-title{font-size:14.5px;font-weight:700;line-height:1.35;margin:0;cursor:pointer;color:var(--ink);min-height:40px;text-wrap:pretty}\n.card-title:hover{color:var(--blue-600)}\n.card-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-top:auto;padding-top:6px}\n.card-b2b{display:flex;flex-wrap:wrap;gap:10px;margin-top:2px}\n.cb2b-it{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:var(--slate-500)}\n.cb2b-it svg{flex-shrink:0}\n.card-foot-btns{display:flex;gap:6px;align-items:center}\n.btn-kp{display:inline-flex;align-items:center;gap:5px;background:var(--blue-600,#1a5fd0);color:#fff;font-weight:700;font-size:13px;height:38px;padding:0 12px;border-radius:9px;transition:.14s;border:1px solid transparent;cursor:pointer;font-family:inherit}\n.btn-kp:hover{background:var(--blue-700,#13469a)}\n[data-density=\"compact\"] .card-b2b{gap:7px}\n[data-density=\"compact\"] .cb2b-it{font-size:11px}\n.btn-buy{display:inline-flex;align-items:center;gap:7px;background:var(--bg);color:var(--blue-700);font-weight:700;font-size:13px;height:38px;padding:0 14px;border-radius:9px;transition:.14s;border:1px solid var(--line)}\n.btn-buy:hover{background:var(--blue-600);color:#fff;border-color:transparent}\n.btn-buy.added{background:var(--success-bg);color:var(--success);border-color:transparent}\n\n/* ===== generic section ===== */\n.section{padding:52px 0}\n.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:26px}\n.sec-head h2{font-size:28px;font-weight:800;letter-spacing:-.025em;margin:0}\n.sec-head .sub{color:var(--slate-500);font-size:14.5px;margin-top:6px}\n.sec-link{display:inline-flex;align-items:center;gap:6px;color:var(--blue-600);font-weight:700;font-size:14px;transition:.14s}\n.sec-link:hover{gap:10px}\n.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n\n/* ===== hero (Stripe-editorial: light base + localized light ribbon) ===== */\n.hero{position:relative;background:linear-gradient(180deg,#ffffff 0%,#f7fafe 55%,#eef5fc 100%);color:var(--ink);overflow:hidden;border-bottom:1px solid var(--line-soft)}\n.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(23,87,200,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(23,87,200,.035) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(120% 90% at 70% 0%,#000 30%,transparent 72%)}\n.hero-wave-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none;z-index:0;opacity:.85}\n/* white grounding so the ribbon stays a localized accent, never colors the whole base */\n.hero-base-fade{position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(85% 70% at 22% 48%,rgba(255,255,255,.78) 0%,rgba(255,255,255,.30) 38%,transparent 60%),linear-gradient(180deg,transparent 60%,rgba(255,255,255,.55) 100%)}\n.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.06fr .94fr;gap:56px;align-items:center;padding:76px 24px 84px}\n.hero-kicker{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.7);backdrop-filter:blur(6px);border:1px solid var(--line);color:var(--blue-700);font-size:12.5px;font-weight:700;padding:6px 14px;border-radius:999px;margin-bottom:22px;letter-spacing:.01em}\n.hero-kicker .hk-dot{width:7px;height:7px;border-radius:50%;background:var(--cyan-500);box-shadow:0 0 0 4px rgba(21,174,216,.18);animation:hk-pulse 2.4s ease-in-out infinite}\n@keyframes hk-pulse{0%,100%{box-shadow:0 0 0 3px rgba(21,174,216,.18)}50%{box-shadow:0 0 0 6px rgba(21,174,216,.06)}}\n.hero h1{font-size:56px;line-height:1.04;font-weight:800;letter-spacing:-.034em;margin:0 0 18px}\n.hero h1 .grad{background:linear-gradient(100deg,var(--blue-600) 10%,var(--cyan-500) 70%,#8c93f0 100%);-webkit-background-clip:text;background-clip:text;color:transparent}\n.hero-sub{font-size:17px;line-height:1.66;color:var(--slate-600);max-width:520px;margin-bottom:32px}\n.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}\n.hero-cta-note{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--slate-500);margin-bottom:34px}\n.hero-cta-note svg{color:var(--cyan-600);flex-shrink:0}\n.hero-stats{display:grid;grid-template-columns:repeat(4,auto);gap:34px}\n.hstat .hs-n{font-size:30px;font-weight:800;letter-spacing:-.025em}\n.hstat .hs-n .u{color:var(--cyan-500)}\n.hstat .hs-l{font-size:12.5px;color:var(--slate-400);margin-top:3px;font-weight:600}\n\n/* ===== hero floating signal cards (V2) ===== */\n.hero-r{position:relative}\n.hero-signals{position:relative;height:100%;min-height:460px}\n.hsig{position:absolute;display:flex;align-items:center;gap:14px;text-align:left;\n  background:rgba(255,255,255,.82);backdrop-filter:blur(14px);\n  border:1px solid rgba(255,255,255,.9);border-radius:18px;\n  box-shadow:0 14px 40px rgba(9,24,48,.12);padding:15px 18px;cursor:pointer;\n  font-family:var(--font);transition:transform .22s cubic-bezier(.16,1,.3,1),box-shadow .22s}\n.hsig:hover{transform:translateY(-4px) scale(1.015);box-shadow:0 20px 50px rgba(9,24,48,.18)}\n.hsig:active{transform:translateY(-1px) scale(.99)}\n.hsig-ic{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.hsig-tx{display:flex;flex-direction:column;min-width:0}\n.hsig-t{font-size:14px;font-weight:800;letter-spacing:-.01em;color:var(--ink);line-height:1.25}\n.hsig-d{font-size:12px;color:var(--slate-500);font-weight:600;margin-top:3px;line-height:1.3}\n.hsig.s1{top:14px;left:14px;right:34px}\n.hsig.s2{top:132px;right:0;left:64px}\n.hsig.s3{top:250px;left:8px;right:44px}\n.hsig.s4{top:368px;right:14px;left:84px}\n@keyframes hsigIn{from{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}\n@media (prefers-reduced-motion: no-preference){\n  .hsig{animation:hsigIn .6s cubic-bezier(.16,1,.3,1) both;animation-delay:var(--d,.2s)}\n}\n\n/* ===== hero branded device collage (bento) ===== */\n.hero-collage{position:relative;border-radius:22px;padding:18px;background:linear-gradient(150deg,rgba(255,255,255,.86),rgba(238,245,252,.7));border:1px solid rgba(200,223,244,.7);box-shadow:0 24px 60px rgba(15,52,120,.13),0 4px 16px rgba(15,52,120,.07);backdrop-filter:blur(8px)}\n.hc-bento{display:grid;grid-template-columns:1.32fr 1fr;grid-template-rows:repeat(3,1fr);gap:12px;aspect-ratio:1/.92;\n  grid-template-areas:\"uzi mon\" \"uzi vent\" \"defib ster\"}\n.hc-tile{background:#fff;border:1px solid var(--line-soft);border-radius:15px;padding:14px 15px;display:flex;flex-direction:column;justify-content:space-between;gap:14px;cursor:pointer;transition:.16s;box-shadow:0 1px 3px rgba(11,31,58,.04);min-width:0}\n.hc-tile:hover{border-color:rgba(23,87,200,.28);box-shadow:0 10px 26px rgba(15,52,120,.12);transform:translateY(-2px)}\n.hc-uzi{grid-area:uzi}.hc-mon{grid-area:mon}.hc-vent{grid-area:vent}.hc-defib{grid-area:defib}.hc-ster{grid-area:ster}\n.hc-big{background:linear-gradient(155deg,#fff 0%,#f4f9ff 100%)}\n.hc-ic{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.hc-big .hc-ic{width:54px;height:54px;border-radius:15px}\n.hc-meta{min-width:0}\n.hc-name{font-size:13.5px;font-weight:800;letter-spacing:-.01em;line-height:1.2;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.hc-big .hc-name{font-size:19px;line-height:1.15;white-space:normal}\n.hc-tag{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;margin-top:5px}\n.hc-big .hc-tag{font-size:12.5px}\n.hc-tag .hc-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0}\n.hero-collage .hero-float{position:absolute}\n.hero-collage .hero-float.f1{top:-14px;left:-20px}\n.hero-collage .hero-float.f2{bottom:-14px;right:-18px}\n[data-theme=\"dark\"] .hero-collage{background:linear-gradient(150deg,rgba(18,32,48,.7),rgba(10,22,40,.6));border-color:var(--line)}\n[data-theme=\"dark\"] .hc-tile{background:var(--surface);border-color:var(--line)}\n[data-theme=\"dark\"] .hc-big{background:linear-gradient(155deg,var(--surface),var(--navy-700))}\n[data-theme=\"dark\"] .hc-name{color:var(--ink)}\n.hero-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:var(--sh-lg)}\n.hero-card .hc-ph{aspect-ratio:4/3;border-radius:14px;background:linear-gradient(150deg,#eaf1fa,#dbe8f6);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;color:var(--blue-600)}\n.hero-card .hc-ph .ph-grid{opacity:.5}\n.hero-card .hc-row{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-top:16px}\n.hero-card .hc-row>div:first-child{min-width:0;flex:1}\n.hero-card .hc-name{font-weight:700;font-size:15px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.hero-card .hc-sku{font-size:12px;color:var(--slate-400);font-family:var(--mono);margin-top:3px}\n.hero-card .hc-price{font-weight:800;font-size:19px;white-space:nowrap;flex-shrink:0}\n.hero-float{position:absolute;background:#fff;color:var(--ink);border-radius:13px;box-shadow:var(--sh-lg);padding:13px 16px;display:flex;align-items:center;gap:11px;font-weight:700;font-size:13.5px}\n.hero-float .hf-ic{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}\n.hero-float.f1{top:8px;left:-26px}\n.hero-float.f2{bottom:96px;right:-22px}\n.hero-float .hf-s{font-size:11.5px;color:var(--slate-500);font-weight:600}\n.hero-float>div>div:first-child{white-space:nowrap}\n\n/* ===== hero video slot ===== */\n.hero-video-slot{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:16/10;background:linear-gradient(150deg,#f4f9ff 0%,#e8f2fc 50%,#eaf6fe 100%);border:1px solid rgba(200,223,244,.8);box-shadow:0 24px 60px rgba(15,52,120,.16),0 4px 14px rgba(15,52,120,.08);flex-shrink:0;backdrop-filter:blur(2px)}\n.hero-video-slot.drag{border:2px dashed var(--blue-500);background:rgba(23,87,200,.05)}\n.hero-video-slot .hvs-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(23,87,200,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(23,87,200,.04) 1px,transparent 1px);background-size:40px 40px;pointer-events:none}\n.hero-vid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}\n.hvs-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.18s}\n.hvs-overlay:hover .hvs-play-btn{transform:scale(1.07);box-shadow:var(--sh-lg)}\n.hvs-play-btn{width:68px;height:68px;border-radius:50%;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);box-shadow:0 8px 28px rgba(14,42,82,.18);display:flex;align-items:center;justify-content:center;color:var(--blue-700);transition:.16s}\n.hvs-change{position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.9);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--blue-700);border:1px solid var(--line);box-shadow:var(--sh-sm);transition:.14s;z-index:4}\n.hvs-change:hover{background:var(--blue-600);color:#fff;border-color:transparent}\n.hvs-change input{display:none}\n.hvs-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:32px;text-align:center;z-index:2}\n.hvs-empty-ic{color:var(--blue-500);opacity:.22;margin-bottom:2px}\n.hvs-empty-badge{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:12.5px;font-weight:700;color:var(--blue-700);box-shadow:var(--sh-sm);margin-bottom:4px}\n.hvs-empty-title{font-size:18px;font-weight:800;color:var(--ink);letter-spacing:-.01em}\n.hvs-empty-sub{font-size:13px;color:var(--slate-400);font-family:var(--mono);margin-top:-2px}\n.hvs-empty .hvs-btn{display:inline-flex;align-items:center;gap:8px;background:var(--grad-brand);color:#fff;font-weight:700;font-size:14px;height:44px;padding:0 22px;border-radius:10px;cursor:pointer;border:none;margin-top:8px;box-shadow:0 4px 14px rgba(26,95,208,.22)}\n.hvs-empty .hvs-btn:hover{filter:brightness(1.06)}\n.hvs-empty .hvs-btn input{display:none}\n/* floats inside video slot */\n.hero-video-slot .hero-float{position:absolute;background:#fff;color:var(--ink);border-radius:13px;box-shadow:var(--sh-lg);padding:11px 14px;display:flex;align-items:center;gap:10px;font-weight:700;font-size:13px;z-index:3}\n.hero-video-slot .hero-float.f1{top:16px;left:16px}\n.hero-video-slot .hero-float.f2{bottom:16px;right:16px}\n.hvs-progress{position:absolute;bottom:0;left:0;right:0;height:3px;background:rgba(255,255,255,.2)}\n.hvs-progress-bar{height:100%;background:var(--grad-brand);transition:width .3s linear}\n\n/* ===== category tiles ===== */\n.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.cat-tile{position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:24px;display:flex;flex-direction:column;gap:16px;overflow:hidden;transition:.16s;cursor:pointer}\n.cat-tile:hover{box-shadow:var(--sh-lg);transform:translateY(-3px);border-color:transparent}\n.cat-tile .ct-ic{width:54px;height:54px;border-radius:14px;background:var(--bg-2);color:var(--blue-600);display:flex;align-items:center;justify-content:center;transition:.16s}\n.cat-tile:hover .ct-ic{background:var(--grad-brand);color:#fff}\n.cat-tile h3{font-size:18px;font-weight:800;margin:0;letter-spacing:-.01em}\n.cat-tile .ct-subs{display:flex;flex-direction:column;gap:4px}\n.cat-tile .ct-subs a{font-size:13.5px;color:var(--slate-500);padding:2px 0}\n.cat-tile .ct-subs a:hover{color:var(--blue-600)}\n.cat-tile .ct-more{margin-top:auto;display:inline-flex;align-items:center;gap:7px;color:var(--blue-600);font-weight:700;font-size:13.5px}\n.cat-tile .ct-watermark{position:absolute;right:-18px;bottom:-18px;color:hsl(210 50% 92%);pointer-events:none}\n.cat-tile .ct-count{position:absolute;top:24px;right:24px;font-family:var(--mono);font-size:12px;color:var(--slate-400);background:var(--bg);padding:3px 9px;border-radius:7px}\n\n/* ===== trust band ===== */\n.trust{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}\n.trust-it{padding:36px 28px;display:flex;flex-direction:column;gap:13px;border-right:1px solid var(--line)}\n.trust-it:last-child{border-right:none}\n.trust-it .ti-ic{width:46px;height:46px;border-radius:12px;background:var(--bg-2);color:var(--cyan-600);display:flex;align-items:center;justify-content:center}\n.trust-it h4{margin:0;font-size:16px;font-weight:800}\n.trust-it p{margin:0;font-size:13.5px;color:var(--slate-500);line-height:1.55}\n\n/* ===== brands ===== */\n/* unified brand-card grid (identical form to corp soi.uz) */\n.brand-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}\n.brand-card{display:flex;align-items:center;gap:15px;background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:16px 18px;transition:.16s;cursor:pointer;text-align:left;width:100%}\n.brand-card:hover{border-color:var(--blue-400);box-shadow:0 10px 28px rgba(9,24,48,.10);transform:translateY(-2px)}\n.brand-card .bc-logo{width:54px;height:54px;flex-shrink:0;border-radius:12px;background:linear-gradient(135deg,var(--blue-50,#eaf2ff),#dbeafb);color:var(--blue-600);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;letter-spacing:.02em}\n.brand-card .bc-info{flex:1;min-width:0;display:flex;flex-direction:column}\n.brand-card .bc-name{font-size:16px;font-weight:800;letter-spacing:-.01em;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.brand-card .bc-cat{font-size:12.5px;color:var(--slate-500);font-weight:600;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n[data-theme=\"dark\"] .brand-card{background:var(--surface);border-color:var(--line)}\n[data-theme=\"dark\"] .brand-card .bc-logo{background:#16273f;color:var(--blue-400)}\n@media(max-width:980px){.brand-grid{grid-template-columns:repeat(3,1fr)}}\n@media(max-width:680px){.brand-grid{grid-template-columns:1fr 1fr}}\n@media(max-width:440px){.brand-grid{grid-template-columns:1fr}}\n.brand-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}\n.brand-chip{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:22px 16px;display:flex;flex-direction:column;align-items:center;gap:7px;transition:.14s;cursor:pointer}\n.brand-chip:hover{box-shadow:var(--sh);border-color:var(--blue-500);transform:translateY(-2px)}\n.brand-chip .bc-name{font-weight:800;font-size:18px;letter-spacing:-.01em}\n.brand-chip .bc-country{font-size:12px;color:var(--slate-400)}\n\n/* compact brand pills (unified Главная + Каталог) */\n.brand-pills{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;max-width:1000px;margin:0 auto;max-height:100px;overflow:hidden}\n.brand-pill{display:inline-flex;align-items:center;gap:9px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:7px 15px 7px 7px;transition:transform .15s,box-shadow .15s,border-color .15s;cursor:pointer}\n.brand-pill:hover{border-color:var(--blue-400);box-shadow:0 6px 18px rgba(9,24,48,.09);transform:translateY(-2px)}\n.brand-pill .bp-mono{width:30px;height:30px;flex-shrink:0;border-radius:50%;background:linear-gradient(135deg,var(--blue-50,#eaf2ff),#dbeafb);color:var(--blue-600);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:11.5px;letter-spacing:.02em}\n.brand-pill .bp-name{font-size:14px;font-weight:700;letter-spacing:-.01em;color:var(--ink);white-space:nowrap}\n.brand-pill .bp-flag{font-size:15px;line-height:1}\n.brand-all-row{display:flex;justify-content:center;margin-top:26px}\n.brand-all-link{display:inline-flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:var(--blue-600);cursor:pointer;transition:gap .15s,opacity .15s}\n.brand-all-link:hover{gap:12px;opacity:.85}\n.brand-h-inline{display:inline-flex;align-items:center;gap:12px}\n.brand-arrow{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--blue-50,#eaf2ff);color:var(--blue-600);font-size:18px;font-weight:700;cursor:pointer;transition:transform .15s,background .15s}\n.brand-arrow:hover{transform:translateX(3px);background:#dbeafb}\n[data-theme=\"dark\"] .brand-arrow{background:#16273f;color:var(--blue-400)}\n[data-theme=\"dark\"] .brand-pill{background:var(--surface);border-color:var(--line)}\n[data-theme=\"dark\"] .brand-pill .bp-mono{background:#16273f;color:var(--blue-400)}\n@media(max-width:560px){.brand-pill .bp-name{font-size:13px}.brand-pill{padding:6px 13px 6px 6px}}\n\n/* ===== CTA band ===== */\n.ctaband{position:relative;background:linear-gradient(115deg,#eaf3fc,#dbeafb);border:1px solid var(--line);border-radius:24px;color:var(--ink);padding:46px 52px;display:flex;align-items:center;gap:40px;overflow:hidden}\n.ctaband .cb-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(26,95,208,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(26,95,208,.06) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(80% 100% at 100% 0,#000,transparent 70%)}\n.ctaband .cb-l{position:relative;flex:1}\n.ctaband h2{font-size:30px;font-weight:800;margin:0 0 12px;letter-spacing:-.02em}\n.ctaband p{margin:0;color:var(--slate-600);font-size:16px;line-height:1.55;max-width:560px}\n.ctaband .cb-r{position:relative;display:flex;flex-direction:column;gap:12px;align-items:flex-end}\n.ctaband .cb-phone{font-size:24px;font-weight:800}\n\n/* ===== service band (per TZ 10.8) ===== */\n.service-band{display:grid;grid-template-columns:1.5fr 1fr;gap:32px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:36px 40px}\n.service-items{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.service-it{display:flex;align-items:center;gap:12px;font-size:14.5px;font-weight:700;color:var(--ink)}\n.service-ic{width:42px;height:42px;flex-shrink:0;border-radius:11px;background:var(--blue-50,#eaf2ff);color:var(--blue-600);display:flex;align-items:center;justify-content:center}\n.sb-card{background:linear-gradient(135deg,var(--blue-50,#eaf2ff),#e7f5fb);border:1px solid var(--line);border-radius:16px;padding:26px