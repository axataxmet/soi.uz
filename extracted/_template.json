;align-items:center;justify-content:center;min-height:140px;color:var(--blue-600,#0E4AC6)}\n.nhm-body{padding:28px 34px 34px;overflow-y:auto}\n.nhm-meta{font-size:13px;font-weight:600;color:var(--slate-500);text-transform:uppercase;letter-spacing:.03em}\n.nhm-title{font-size:26px;line-height:1.22;font-weight:800;color:var(--slate-900,#0e2044);margin-top:10px}\n.nhm-text{margin-top:16px;font-size:15.5px;line-height:1.7;color:var(--slate-700)}\n.nhm-text p{margin-bottom:13px}\n@media(max-width:560px){.nhm-body{padding:22px 20px 28px}.nhm-title{font-size:21px}}\n.reco-modal-body{display:flex;gap:24px;padding:30px 28px;align-items:flex-start}\n.reco-modal--img .reco-modal-body,.reco-modal--pdf .reco-modal-body{padding:20px;justify-content:center}\n.reco-modal-text-col{flex:1 1 auto;min-width:0}\n.reco-modal--pdf .reco-modal-body{flex-direction:column}\n.reco-modal--pdf .reco-modal-text-col{flex:none;width:100%}\n.reco-modal-co{font-size:21px;font-weight:800;margin-bottom:12px}\n.reco-modal-text{font-size:14.5px;line-height:1.7;color:var(--slate-600);font-weight:500;text-wrap:pretty}\n[data-theme=\"dark\"] .rt-sheet{background:#f3f5f8}\n@media(max-width:780px){.reco-card{flex:0 0 100%;flex-direction:column;gap:14px;align-items:center;text-align:center}.reco-card-body{padding-top:0}.reco-thumb{width:104px}.reco-track{transition:transform .4s ease}.reco-modal-body{flex-direction:column;align-items:center;text-align:center}}\n\n/* ===== toast ===== */\n.toast{position:fixed;top:96px;right:24px;z-index:90;background:var(--ink);color:#fff;border-radius:12px;padding:13px 18px;display:flex;align-items:center;gap:11px;font-weight:600;font-size:14px;box-shadow:var(--sh-lg);animation:slidein .25s}\n.toast .t-ic{width:26px;height:26px;border-radius:8px;background:var(--success);display:flex;align-items:center;justify-content:center}\n@keyframes slidein{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}\n\n/* ===== modal ===== */\n.modal-ov{position:fixed;inset:0;background:rgba(10,28,56,.5);backdrop-filter:blur(3px);z-index:80;display:flex;align-items:center;justify-content:center;padding:24px;animation:fade .15s}\n.modal{background:#fff;border-radius:var(--r-xl);width:100%;max-width:520px;box-shadow:var(--sh-lg);overflow:hidden;max-height:92vh;overflow-y:auto}\n.modal-head{padding:26px 28px 0;position:relative}\n.modal-head h3{font-size:22px;font-weight:800;margin:0 0 8px}\n.modal-head p{font-size:14px;color:var(--slate-500);margin:0}\n.modal-close{position:absolute;top:20px;right:20px;width:36px;height:36px;border-radius:9px;background:var(--bg-2);color:var(--slate-600);display:flex;align-items:center;justify-content:center}\n.modal-close:hover{background:#e0492f;color:#fff}\n.modal-body{padding:24px 28px 28px}\n.field{margin-bottom:16px}\n.field label{display:block;font-size:13px;font-weight:700;color:var(--slate-600);margin-bottom:7px}\n.field input,.field textarea{width:100%;border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;font-size:14.5px;outline:none;transition:.12s}\n.field input:focus,.field textarea:focus{border-color:var(--blue-500);box-shadow:0 0 0 3px rgba(47,120,230,.1)}\n.field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.modal-ok{text-align:center;padding:18px 0 8px}\n.modal-ok .ok-ic{width:64px;height:64px;border-radius:50%;background:var(--success-bg);color:var(--success);display:inline-flex;align-items:center;justify-content:center;margin-bottom:18px}\n.modal-ok h3{font-size:22px;margin:0 0 8px}\n.modal-ok p{color:var(--slate-500);margin:0 0 22px}\n\n/* ===== cart page ===== */\n.cart-page{padding:8px 0 56px}\n.cart-page h1{font-size:30px;font-weight:800;margin:0 0 24px;letter-spacing:-.02em}\n.cart-layout{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}\n.cart-items{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}\n.cart-row{display:grid;grid-template-columns:96px 1fr auto;gap:18px;padding:20px;border-bottom:1px solid var(--line);align-items:center}\n.cart-row:last-child{border-bottom:none}\n.cart-row .cr-img{width:96px;height:84px;border-radius:11px;overflow:hidden;border:1px solid var(--line)}\n.cart-row .cr-img .ph{aspect-ratio:96/84;border-radius:0}\n.cart-row .cr-name{font-weight:700;font-size:15px;line-height:1.35;margin:0 0 6px;cursor:pointer}\n.cart-row .cr-name:hover{color:var(--blue-600)}\n.cart-row .cr-meta{display:flex;gap:14px;align-items:center;font-size:12.5px}\n.cart-row .cr-right{display:flex;flex-direction:column;align-items:flex-end;gap:12px}\n.cart-row .cr-del{color:var(--slate-400);display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600}\n.cart-row .cr-del:hover{color:#e0492f}\n.cart-sum{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:24px;position:sticky;top:156px}\n.cart-sum h3{margin:0 0 18px;font-size:18px;font-weight:800}\n.sum-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;font-size:14.5px;color:var(--slate-600)}\n.sum-row.total{border-top:1px solid var(--line);margin-top:8px;padding-top:16px;font-size:16px}\n.sum-row.total .st-val{font-size:24px;font-weight:800;color:var(--ink)}\n.sum-vat{font-size:12px;color:var(--slate-400);font-weight:600}\n.cart-note{display:flex;gap:10px;background:var(--bg);border-radius:11px;padding:14px;font-size:12.5px;color:var(--slate-500);line-height:1.5;margin-top:16px}\n.cart-note svg{color:var(--cyan-600);flex-shrink:0}\n.cart-clear-link{display:inline-flex;align-items:center;gap:7px;color:var(--slate-500);font-size:13.5px;font-weight:600;margin-top:18px}\n.cart-clear-link:hover{color:#e0492f}\n\n/* ===== smart search dropdown ===== */\n.search-wrap{position:relative;flex:1}\n.search-drop{position:absolute;top:calc(100% + 10px);left:0;right:0;background:#fff;border:1.5px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--sh-lg);z-index:70;overflow:hidden;animation:fade .13s}\n.sd-section{font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--slate-400);padding:11px 16px 6px;display:flex;align-items:center;gap:8px}\n.sd-item{display:flex;align-items:center;gap:12px;padding:10px 16px;cursor:pointer;color:var(--slate-700);font-size:14px;font-weight:600;transition:.1s}\n.sd-item:hover{background:var(--bg-2);color:var(--blue-600)}\n.sd-item .sdi-ic{width:32px;height:32px;border-radius:8px;background:var(--bg-2);display:flex;align-items:center;justify-content:center;color:var(--blue-600);flex-shrink:0}\n.sd-item .sdi-name{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sd-item .sdi-brand{font-size:12px;color:var(--slate-400);font-weight:600;flex-shrink:0}\n.sd-item .sdi-del{opacity:0;margin-left:auto;color:var(--slate-400);width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center}\n.sd-item:hover .sdi-del{opacity:1}\n.sd-item .sdi-del:hover{background:var(--bg-2);color:#e0492f}\n.sd-sep{height:1px;background:var(--line);margin:4px 0}\n\n/* ===== brand page ===== */\n.brand-hero{background:linear-gradient(160deg,#f0f5ff 0%,#e8f3fc 60%,#f0fdf5 100%);border-bottom:1px solid var(--line);padding:40px 0}\n.brand-hero-inner{display:flex;align-items:flex-start;gap:24px;margin-bottom:28px}\n.brand-logo-big{width:80px;height:80px;border-radius:18px;background:var(--navy-850);color:var(--cyan-500);font-weight:900;font-size:26px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:var(--sh)}\n.brand-hero-info{flex:1}\n.brand-hero-name{font-size:36px;font-weight:800;letter-spacing:-.02em;margin-bottom:8px}\n.brand-hero-meta{display:flex;gap:20px;flex-wrap:wrap;font-size:14px;color:var(--slate-600);font-weight:600;margin-bottom:14px}\n.brand-hero-desc{font-size:15.5px;line-height:1.65;color:var(--slate-600);max-width:640px}\n.brand-hero-stats{display:flex;gap:32px;padding-top:22px;border-top:1px solid rgba(26,95,208,.12)}\n.bhs .bhs-n{font-size:28px;font-weight:800;letter-spacing:-.02em;color:var(--blue-700)}\n.bhs .bhs-l{font-size:13px;color:var(--slate-500);margin-top:2px}\n\n/* ===== info pages ===== */\n.info-layout{display:grid;grid-template-columns:1fr 320px;gap:36px;align-items:start;padding-top:4px}\n.info-title{font-size:32px;font-weight:800;letter-spacing:-.02em;margin-bottom:8px}\n.info-block{margin-bottom:28px}\n.info-block h3{font-size:18px;font-weight:800;margin-bottom:12px;color:var(--ink)}\n.info-block p{font-size:15.5px;line-height:1.7;color:var(--slate-600)}\n.info-block ul{padding-left:0;list-style:none;display:flex;flex-direction:column;gap:8px;margin-top:8px}\n.info-block ul li{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--slate-700);line-height:1.45}\n.info-block ul li::before{content:\"\";width:7px;height:7px;border-radius:50%;background:var(--blue-500);flex-shrink:0;margin-top:7px}\n.info-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:16px}\n.info-stat{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px 14px;text-align:center;box-shadow:var(--sh-sm)}\n.is-n{font-size:28px;font-weight:800;letter-spacing:-.02em;color:var(--blue-700)}\n.is-l{font-size:12.5px;color:var(--slate-500);margin-top:4px;font-weight:600}\n.info-side-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:22px;box-shadow:var(--sh-sm)}\n.info-side-card h4{font-size:15px;font-weight:800;margin-bottom:10px}\n.info-side-card p{font-size:13.5px;color:var(--slate-600);line-height:1.55}\n.info-contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:24px}\n.icc{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--sh-sm)}\n.icc-ic{width:40px;height:40px;border-radius:10px;background:var(--bg-2);color:var(--blue-600);display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.icc-v{font-size:14px;font-weight:600;line-height:1.55}\n@media(max-width:860px){.info-layout{grid-template-columns:1fr}.info-stats{grid-template-columns:repeat(2,1fr)}.brand-hero-inner{flex-wrap:wrap}.brand-hero-stats{flex-wrap:wrap}.info-contact-grid{grid-template-columns:1fr}}\n\n/* ===== FAB widget ===== */\n.fab-wrap{position:fixed;bottom:28px;right:28px;z-index:66;display:flex;flex-direction:column;align-items:flex-end;gap:10px;transition:bottom .3s cubic-bezier(.16,1,.3,1)}\n/* lift FAB above the compare bar when it is shown */\nbody:has(.cmpbar.show) .fab-wrap{bottom:96px}\n.fab-main{width:56px;height:56px;border-radius:50%;background:var(--grad-brand);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 22px rgba(26,95,208,.35);transition:.18s;border:none;cursor:pointer}\n.fab-main:hover{transform:scale(1.07);box-shadow:0 8px 28px rgba(26,95,208,.45)}\n.fab-main.pulse{animation:fab-pulse 2.4s ease-in-out 1.5s 3}\n@keyframes fab-pulse{0%,100%{box-shadow:0 6px 22px rgba(26,95,208,.35)}50%{box-shadow:0 6px 22px rgba(26,95,208,.35),0 0 0 12px rgba(26,95,208,.12)}}\n.fab-channels{display:flex;flex-direction:column;gap:8px;align-items:flex-end;animation:fade .15s}\n.fab-ch{display:flex;align-items:center;gap:10px;border:none;cursor:pointer;background:var(--ch-bg,#fff);color:var(--ch-color,var(--blue-600));border-radius:24px;padding:10px 16px 10px 12px;font-weight:700;font-size:14px;font-family:var(--font);box-shadow:0 4px 16px rgba(10,28,56,.12);white-space:nowrap;transition:.13s;text-decoration:none}\n.fab-ch:hover{transform:translateX(-4px);box-shadow:0 6px 20px rgba(10,28,56,.18)}\n.fab-ch-ic{width:30px;height:30px;border-radius:50%;background:var(--ch-color);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.fab-ch-label{color:var(--ink)}\n\n/* ===== account page ===== */\n.acc-login-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:36px 32px;box-shadow:var(--sh-lg)}\n.acc-layout{display:grid;grid-template-columns:260px 1fr;gap:28px;padding-top:8px;align-items:start}\n.acc-side{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;position:sticky;top:160px}\n.acc-who{padding:20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:13px}\n.acc-avatar{width:46px;height:46px;border-radius:12px;background:var(--grad-brand);color:#fff;font-weight:900;font-size:17px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.acc-name{font-weight:800;font-size:15px}\n.acc-email{font-size:12.5px;color:var(--slate-400);font-family:var(--mono);margin-top:2px}\n.acc-org{font-size:12px;color:var(--slate-500);margin-top:3px}\n.acc-nav{padding:10px 10px 6px}\n.acc-navitem{display:flex;align-items:center;gap:11px;width:100%;padding:11px 12px;border-radius:10px;color:var(--slate-600);font-weight:600;font-size:14px;text-align:left;transition:.12s;margin-bottom:2px}\n.acc-navitem:hover{background:var(--bg-2);color:var(--blue-700)}\n.acc-navitem.on{background:var(--blue-600);color:#fff}\n.acc-logout{display:flex;align-items:center;gap:9px;width:100%;padding:12px 22px;color:var(--slate-500);font-weight:700;font-size:13.5px;border-top:1px solid var(--line)}\n.acc-logout:hover{color:#e0492f;background:var(--bg-2)}\n.acc-main{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:28px}\n.acc-sec-title{font-size:22px;font-weight:800;margin-bottom:20px;letter-spacing:-.01em}\n.acc-orders{display:flex;flex-direction:column;gap:12px}\n.acc-order-card{border:1px solid var(--line);border-radius:12px;padding:16px 18px}\n.aoc-head{display:flex;align-items:center;gap:14px;margin-bottom:10px}\n.aoc-num{font-weight:700;font-size:13px;flex:1}\n.aoc-date{font-size:12px;color:var(--slate-400)}\n.aoc-body{display:flex;justify-content:space-between;font-size:14px}\n.aoc-total{font-weight:800;font-family:var(--mono)}\n.acc-kp-card{border:1px solid var(--line);border-radius:12px;padding:18px 20px}\n.acc-form{max-width:520px;display:flex;flex-direction:column;gap:4px}\n@media(max-width:820px){.acc-layout{grid-template-columns:1fr}.acc-side{position:static}}\n\n/* ===== tenders page ===== */\n.tnd-hero{background:radial-gradient(120% 140% at 80% -10%,#16407e 0%,#0e2a52 45%,#0a1c38 100%);padding:56px 0}\n.tnd-hero-inner{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:start}\n.tnd-hero-stats{display:grid;grid-template-columns:repeat(2,auto);gap:24px 36px;flex-shrink:0}\n.tnd-stat{text-align:center;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:18px 22px}\n.ts-n{font-size:28px;font-weight:800;letter-spacing:-.02em;color:#fff}\n.ts-l{font-size:12.5px;color:#9fb4cf;margin-top:3px;font-weight:600}\n.hover-card{transition:.14s}\n.hover-card:hover{box-shadow:var(--sh);border-color:var(--blue-500)!important;transform:translateX(3px)}\n@media(max-width:980px){.tnd-hero-inner{grid-template-columns:1fr}.tnd-hero-stats{grid-template-columns:repeat(4,auto)}}\n[data-cards=\"flat\"] .card{box-shadow:none!important;transform:none!important;border:1.5px solid var(--line)!important;border-radius:var(--r)!important}\n[data-cards=\"flat\"] .card:hover{box-shadow:none!important;transform:none!important;border-color:var(--blue-500)!important}\n[data-cards=\"flat\"] .cat-tile{box-shadow:none!important;transform:none!important;border:1.5px solid var(--line)!important}\n[data-cards=\"flat\"] .cat-tile:hover{border-color:var(--blue-500)!important;transform:none!important;box-shadow:none!important}\n[data-cards=\"glass\"] .app-main{background:linear-gradient(155deg,#dbeafe 0%,#e0f2fe 35%,#f0faf8 70%,#f3f4ff 100%)}\n[data-cards=\"glass\"] .card{background:rgba(255,255,255,.55)!important;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1.5px solid rgba(255,255,255,.88)!important;box-shadow:0 6px 24px rgba(14,42,82,.07)!important}\n[data-cards=\"glass\"] .card:hover{background:rgba(255,255,255,.75)!important;box-shadow:0 18px 50px rgba(14,42,82,.12)!important;transform:translateY(-3px)}\n[data-cards=\"glass\"] .cat-tile{background:rgba(255,255,255,.55)!important;backdrop-filter:blur(14px);border:1.5px solid rgba(255,255,255,.88)!important}\n[data-cards=\"glass\"] .trust{background:rgba(255,255,255,.45);backdrop-filter:blur(10px)}\n[data-cards=\"glass\"] .head,[data-cards=\"glass\"] .nav{background:rgba(255,255,255,.8);backdrop-filter:blur(18px)}\n\n/* ===== tweaks: density ===== */\n[data-density=\"compact\"] .section{padding:32px 0}\n[data-density=\"compact\"] .grid-4,[data-density=\"compact\"] .cat-grid-p{gap:12px}\n[data-density=\"compact\"] .cat-grid{gap:12px}\n[data-density=\"compact\"] .card{padding:8px}\n[data-density=\"compact\"] .card-body{gap:6px;padding:10px 4px 4px}\n[data-density=\"compact\"] .card-title{font-size:13.5px;min-height:34px}\n[data-density=\"compact\"] .hero .wrap{padding:44px 24px 52px}\n[data-density=\"compact\"] .sec-head{margin-bottom:18px}\n[data-density=\"compact\"] .sec-head h2{font-size:24px}\n[data-density=\"compact\"] .trust-it{padding:24px 20px}\n\n[data-density=\"spacious\"] .section{padding:80px 0}\n[data-density=\"spacious\"] .grid-4,[data-density=\"spacious\"] .cat-grid-p{gap:28px}\n[data-density=\"spacious\"] .cat-grid{gap:24px}\n[data-density=\"spacious\"] .card{padding:18px}\n[data-density=\"spacious\"] .card-body{gap:12px;padding:18px 8px 8px}\n[data-density=\"spacious\"] .card-title{font-size:16px;min-height:46px}\n[data-density=\"spacious\"] .hero .wrap{padding:88px 24px 104px}\n[data-density=\"spacious\"] .sec-head h2{font-size:36px}\n[data-density=\"spacious\"] .trust-it{padding:48px 36px}\n[data-density=\"spacious\"] body{font-size:16px}\n\n/* ===== mobile ===== */\n.mob-only{display:none}\n@media(max-width:1080px){\n  .grid-4,.cat-grid-p{grid-template-columns:repeat(2,1fr)}\n  .cat-grid{grid-template-columns:repeat(2,1fr)}\n  .trust-grid{grid-template-columns:repeat(2,1fr)}\n  .trust-it:nth-child(2){border-right:none}\n  .trust-it{border-bottom:1px solid var(--line)}\n  .hero .wrap{grid-template-columns:1fr;gap:36px}\n  .hero-card{max-width:460px}\n  .hero-r{display:none}\n  .pdp{grid-template-columns:1fr;gap:28px}\n  .pdp-gallery{position:static}\n  .cart-layout{grid-template-columns:1fr}\n  .foot-top{grid-template-columns:1fr 1fr 1fr}\n}\n@media(max-width:1180px){.ubar-info.delivery{display:none}}\n@media(max-width:860px){\n  .head .wrap{height:68px;gap:14px}\n  .nav-links,.ubar-links,.nav-phone,.search-btn span{display:none}\n  .hact span{display:none}\n  .head-actions{gap:2px}\n  .cat-layout{grid-template-columns:1fr}\n  .flt-trigger{display:flex}\n  .filters{position:fixed;top:0;left:0;bottom:0;width:86%;max-width:340px;z-index:130;border-radius:0;border:none;overflow-y:auto;transform:translateX(-100%);transition:transform .3s cubic-bezier(.16,1,.3,1);box-shadow:0 0 60px rgba(9,24,48,.3)}\n  .filters.open{transform:translateX(0)}\n  .filters-backdrop{display:block;position:fixed;inset:0;background:rgba(9,24,48,.5);z-index:125;opacity:0;pointer-events:none;transition:opacity .3s}\n  .filters-backdrop.show{opacity:1;pointer-events:auto}\n  .flt-close{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9px;background:var(--bg-2);color:var(--slate-600)}\n  .flt-apply{display:block;position:sticky;bottom:0;width:calc(100% - 32px);margin:16px;height:50px;background:var(--grad-brand);color:#fff;font-weight:700;font-size:15px;border-radius:11px}\n  .hero h1{font-size:38px}\n  .hero-stats{grid-template-columns:repeat(2,1fr);gap:22px}\n  .sec-head h2{font-size:24px}\n  .ctaband{flex-direction:column;align-items:flex-start;padding:32px 28px}\n  .ctaband .cb-r{align-items:flex-start;margin-top:8px}\n  .brand-strip{grid-template-columns:repeat(2,1fr)}\n}\n@media(max-width:620px){\n  .wrap{padding:0 16px}\n  .grid-4,.cat-grid-p,.cat-grid,.grid-3{grid-template-columns:1fr}\n  .trust-grid{grid-template-columns:1fr}\n  .trust-it{border-right:none}\n  .foot-top{grid-template-columns:1fr 1fr}\n  .hero-stats{grid-template-columns:1fr 1fr}\n  .field-row{grid-template-columns:1fr}\n  .cart-row{grid-template-columns:72px 1fr;gap:14px}\n  .cart-row .cr-right{grid-column:2;flex-direction:row;justify-content:space-between;width:100%}\n  .pdp-guarantees{grid-template-columns:1fr}\n  .mob-only{display:flex}\n  .mega-inner{grid-template-columns:1fr}\n  /* ubar: hide all info links, show only lang+theme */\n  .ubar-info{display:none}\n  .ubar-links{display:none}\n}\n\n/* ===== extra-small phones ≤480px ===== */\n@media(max-width:480px){\n  /* hide utility bar completely — shown in mob-bottom-nav instead */\n  .ubar{display:none}\n  /* hero */\n  .hero h1{font-size:26px;line-height:1.2}\n  .hero-sub{font-size:15px}\n  .hero-btns{flex-direction:column;align-items:stretch;gap:10px}\n  .hero-btns .btn{justify-content:center;width:100%}\n  .hero-card{max-width:100%}\n  /* catalog bar */\n  .cat-bar{flex-direction:column;align-items:flex-start;gap:10px}\n  .cat-bar-controls{width:100%;justify-content:space-between}\n  .sort-sel{flex:1;min-width:0}\n  .sort-sel select{width:100%}\n  /* product page */\n  .pdp-buy-row{flex-direction:column;align-items:flex-start;gap:8px}\n  .pdp-actions{flex-wrap:wrap}\n  .pdp-actions .btn:last-child{flex:1 0 100%}\n  /* news */\n  .news-card{flex-direction:column;gap:12px}\n  .nc-ic{width:44px;height:44px;border-radius:12px;flex-shrink:0}\n  /* faq */\n  .faq-q{font-size:14px;padding:14px 16px}\n  .faq-item.open .faq-a{padding:0 16px 16px}\n  .faq-cta{flex-direction:column}\n  /* contacts map */\n  .map-card{flex-wrap:wrap}\n  .map-card-link{margin-left:0;width:100%;margin-top:8px;justify-content:flex-start}\n  /* tenders */\n  .tnd-hero-stats{grid-template-columns:repeat(2,1fr)}\n  /* footer */\n  .foot-top{grid-template-columns:1fr}\n  .foot-bot{padding:16px 0}\n  .foot-socs-row{flex-wrap:wrap;gap:8px}\n  .foot-copy{font-size:11px}\n  /* crm settings 2-col grid → 1 col */\n  div[style*=\"grid-template-columns:1fr 1fr\"]{display:flex !important;flex-direction:column !important}\n  /* compare bar: full width, scroll */\n  .cmp-bar-items{overflow-x:auto;padding-bottom:4px}\n  /* account layout */\n  .acc-layout{grid-template-columns:1fr}\n}\n\n/* ===== very small phones ≤400px ===== */\n@media(max-width:400px){\n  .head .search{max-width:140px}\n  .brand-logo-img{height:32px}\n  .brand-tag{display:none}\n  .hact{gap:0}\n  .head-actions{gap:0}\n  .hero h1{font-size:23px}\n  .hero-card{padding:20px 16px}\n  .sect{padding:36px 0}\n  .pdp-price-val{font-size:26px}\n  .foot-top{gap:24px}\n  .sec-head h2{font-size:21px}\n  .bento-grid{grid-template-columns:1fr !important;grid-template-rows:auto !important}\n  .bento-cell{grid-column:auto !important;grid-row:auto !important;aspect-ratio:auto !important}\n}\n\n/* ===== price list page ===== */\n.pl-hero{background:linear-gradient(160deg,#f0f5ff 0%,#e8f3fc 60%,#f0faf8 100%);border-bottom:1px solid var(--line);padding:32px 0 28px}\n.pl-hero-inner{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}\n.pl-title{font-size:34px;font-weight:800;letter-spacing:-.02em;margin-bottom:6px}\n.pl-sub{font-size:14.5px;color:var(--slate-500)}\n.pl-dl-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.pl-dl-btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px;height:44px;padding:0 20px;border-radius:10px;cursor:pointer;border:1.5px solid;transition:.13s;font-family:var(--font)}\n.pl-dl-btn.excel{background:#e7f6ef;color:#15a06a;border-color:#b3e6cc}\n.pl-dl-btn.excel:hover{background:#15a06a;color:#fff;border-color:#15a06a}\n.pl-dl-btn.pdf{background:#fdecea;color:#e0492f;border-color:#fca5a5}\n.pl-dl-btn.pdf:hover{background:#e0492f;color:#fff;border-color:#e0492f}\n.pl-dl-ok{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--success);animation:fade .2s}\n.pl-filters{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px}\n.pl-count{font-size:13px;color:var(--slate-500);font-weight:700;white-space:nowrap;margin-left:auto}\n.pl-table-wrap{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);overflow:auto;box-shadow:var(--sh-sm)}\n.pl-table{width:100%;border-collapse:collapse;font-size:14px}\n.pl-table th{background:var(--navy-900);color:#fff;padding:11px 14px;text-align:left;font-size:11.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;position:sticky;top:0;z-index:2}\n.pl-table td{padding:11px 14px;border-bottom:1px solid var(--line);vertical-align:middle}\n.pl-row{cursor:pointer;transition:.1s}\n.pl-row:hover td{background:rgba(26,95,208,.03)}\n.pl-row:last-child td{border-bottom:none}\n.pl-cat-row td{background:var(--bg-2);padding:8px 14px;border-bottom:1px solid var(--line)}\n.pl-cat-label{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--slate-500)}\n.pl-cat-cnt{background:var(--line);border-radius:999px;padding:1px 8px;font-size:11px;font-weight:800;color:var(--slate-500)}\n.pl-table tfoot td{background:var(--bg);border-top:2px solid var(--navy-900)}\n@media(max-width:820px){.pl-hero-inner{flex-direction:column;align-items:flex-start}.pl-filters{gap:8px}.pl-table th:nth-child(4),.pl-table td:nth-child(4),.pl-table th:nth-child(5),.pl-table td:nth-child(5){display:none}}\n.rev-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}\n/* ===== directions grid ===== */\n.dir-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px;margin-bottom:32px}\n.dir-card{background:#fff;border:1.5px solid var(--line);border-radius:var(--r-lg);overflow:hidden;cursor:pointer;transition:.15s;display:flex;flex-direction:column}\n.dir-card:hover{border-color:var(--blue-400);box-shadow:var(--sh);transform:translateY(-2px)}\n.dir-card-img{background:linear-gradient(135deg,#f0f5ff,#e8f3fc);aspect-ratio:1.4;display:flex;align-items:center;justify-content:center}\n.dir-glyph{width:80px;height:80px;display:flex;align-items:center;justify-content:center}\n.dir-glyph svg{width:72px;height:72px}\n.dir-card-body{padding:12px 14px 14px}\n.dir-card-name{font-size:13.5px;font-weight:700;line-height:1.35;margin-bottom:4px;color:var(--ink)}\n.dir-card-count{font-size:12px;color:var(--slate-400);font-weight:600}\n@media(max-width:480px){.dir-grid{grid-template-columns:repeat(2,1fr)}}\n.rev-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:20px;box-shadow:var(--sh-sm)}\n.rc-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}\n.rc-date{font-size:12px;color:var(--slate-400);font-family:var(--mono)}\n.rc-text{font-size:14px;line-height:1.6;color:var(--slate-700);font-style:italic;margin-bottom:12px}\n.rc-author{font-size:13px;color:var(--slate-500);font-weight:600}\n.rev-head{margin-bottom:24px}\n\n/* ===== news ===== */\n.news-layout{display:grid;grid-template-columns:1fr 300px;gap:32px;align-items:start}\n.news-cats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}\n.nc{padding:8px 16px;border-radius:999px;font-weight:700;font-size:13.5px;border:1.5px solid var(--line);color:var(--slate-600);background:#fff;cursor:pointer;transition:.13s}\n.nc.on{background:var(--blue-600);color:#fff;border-color:transparent}\n.nc:hover:not(.on){border-color:var(--blue-500);color:var(--blue-600)}\n.news-list{display:flex;flex-direction:column;gap:16px}\n.news-card{display:flex;gap:18px;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:22px;cursor:pointer;transition:.14s;box-shadow:var(--sh-sm)}\n.news-card:hover{box-shadow:var(--sh);transform:translateY(-2px);border-color:var(--blue-400)}\n.nc-ic{width:52px;height:52px;border-radius:14px;background:var(--bg-2);color:var(--blue-600);display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.nc-body{flex:1;min-width:0}\n.nc-meta{display:flex;gap:12px;font-size:12.5px;font-weight:700;margin-bottom:8px}\n.nc-cat{color:var(--blue-600)}\n.nc-date{color:var(--slate-400);font-family:var(--mono)}\n.nc-title{font-size:16px;font-weight:800;margin-bottom:6px;line-height:1.35}\n.nc-text{font-size:13.5px;color:var(--slate-600);line-height:1.55}\n.news-home-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.nhg-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:22px;cursor:pointer;transition:.14s;box-shadow:var(--sh-sm)}\n.nhg-card:hover{box-shadow:var(--sh);transform:translateY(-2px);border-color:var(--blue-400)}\n.nhg-ic{width:40px;height:40px;border-radius:11px;background:var(--bg-2);color:var(--blue-600);display:flex;align-items:center;justify-content:center;margin-bottom:14px}\n.nhg-cat{font-size:12px;font-weight:700;color:var(--blue-600);margin-bottom:6px}\n.nhg-title{font-size:14.5px;font-weight:800;margin-bottom:8px;line-height:1.35}\n.nhg-text{font-size:13px;color:var(--slate-500);line-height:1.5}\n\n/* ===== kits ===== */\n.kit-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:0;overflow:hidden;cursor:pointer;transition:.14s;box-shadow:var(--sh-sm)}\n.kit-card:hover{box-shadow:var(--sh-lg);transform:translateY(-3px)}\n.kc-head{display:flex;gap:16px;align-items:flex-start;padding:22px 22px 18px;border-bottom:1px solid var(--line)}\n.kc-ic{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.kc-title{font-size:18px;font-weight:800;margin-bottom:6px}\n.kc-desc{font-size:13.5px;color:var(--slate-600);line-height:1.5}\n.kc-meta{display:flex;align-items:center;justify-content:space-between;padding:14px 22px;background:var(--bg)}\n.kc-sum{display:flex;align-items:baseline;gap:5px}\n.kcs-from{font-size:12px;color:var(--slate-400);font-weight:600}\n.kcs-val{font-size:22px;font-weight:800;font-family:var(--mono);color:var(--blue-700)}\n.kcs-cur{font-size:13px;color:var(--slate-500)}\n.kc-time{font-size:13px;color:var(--slate-500);display:flex;align-items:center;gap:6px;font-weight:600}\n.kc-items{padding:18px 22px;border-top:1px solid var(--line)}\n\n/* ===== tracking ===== */\n.track-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:28px;box-shadow:var(--sh-lg)}\n.trk-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}\n.trk-num{font-size:20px;font-weight:800;letter-spacing:-.01em}\n.trk-steps{display:flex;align-items:flex-start;position:relative;margin:0 0 8px}\n.trk-step{display:flex;flex-direction:column;align-items:center;flex:1;position:relative}\n.trk-dot{width:36px;height:36px;border-radius:50%;background:var(--bg-2);color:var(--slate-400);border:2px solid var(--line);display:flex;align-items:center;justify-content:center;z-index:2;position:relative;transition:.2s}\n.trk-dot.done{background:var(--blue-600);color:#fff;border-color:var(--blue-600)}\n.trk-dot.active{background:var(--blue-600);color:#fff;border-color:var(--blue-600);box-shadow:0 0 0 5px rgba(26,95,208,.15)}\n.trk-line{position:absolute;top:17px;left:calc(50% + 18px);right:calc(-50% + 18px);height:2px;background:var(--line);z-index:1;transition:.2s}\n.trk-line.done{background:var(--blue-600)}\n.trk-s-label{font-size:12px;font-weight:700;color:var(--slate-600);margin-top:8px;text-align:center}\n.trk-s-date{font-size:11px;color:var(--slate-400);font-family:var(--mono);margin-top:2px;text-align:center}\n\n@media(max-width:860px){.news-layout{grid-template-columns:1fr}.news-home-grid{grid-template-columns:1fr}.rev-grid{grid-template-columns:1fr}.trk-s-label{font-size:10px}}\n\n/* ===== mobile nav ===== */\n.mob-hamburger{display:none;width:44px;height:44px;border-radius:10px;align-items:center;justify-content:center;background:var(--bg-2);color:var(--ink);border:1.5px solid var(--line);flex-shrink:0}\n.mob-ov{position:fixed;inset:0;background:rgba(10,28,56,.45);z-index:70;animation:fade .15s}\n.mob-drawer{position:fixed;top:0;left:0;bottom:0;width:320px;max-width:88vw;background:#fff;z-index:71;overflow-y:auto;box-shadow:8px 0 40px rgba(10,28,56,.18);animation:slide-in-left .2s cubic-bezier(.2,.8,.2,1)}\n@keyframes slide-in-left{from{transform:translateX(-100%)}to{transform:none}}\n.mob-drawer-head{display:flex;align-items:center;justify-content:space-between;padding:18px 18px 14px;border-bottom:1px solid var(--line)}\n.mob-close{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:var(--bg-2);color:var(--slate-600)}\n.mob-search{display:flex;align-items:center;gap:10px;margin:14px;background:var(--bg);border-radius:10px;padding:0 14px;height:44px}\n.mob-search input{flex:1;border:none;background:none;outline:none;font-size:14px;font-family:var(--font)}\n.mob-section-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--slate-400);padding:12px 18px 6px}\n.mob-cat-item{display:flex;align-items:center;gap:12px;padding:13px 18px;cursor:pointer;font-size:14.5px;font-weight:600;border-bottom:1px solid var(--line);transition:.12s}\n.mob-cat-item:hover{background:var(--bg-2);color:var(--blue-600)}\n.mob-cat-ic{width:34px;height:34px;border-radius:9px;background:var(--bg-2);color:var(--blue-600);display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.mob-nav-item{padding:13px 18px;font-size:14.5px;font-weight:600;color:var(--slate-700);cursor:pointer;border-bottom:1px solid var(--line)}\n.mob-nav-item:hover{background:var(--bg-2);color:var(--blue-600)}\n/* mobile catalog accordion */\n.mob-acc{border-bottom:1px solid var(--line)}\n.mob-acc-head{display:flex;align-items:center;gap:12px;width:100%;padding:13px 18px;background:none;border:none;font-size:14.5px;font-weight:600;color:var(--slate-700);cursor:pointer;text-align:left}\n.mob-acc-head:hover{background:var(--bg-2);color:var(--blue-600)}\n.mob-acc-head>span:nth-child(2){flex:1;min-width:0}\n.mob-acc-chev{margin-left:auto;color:var(--slate-400);transition:transform .2s}\n.mob-acc.open .mob-acc-chev{transform:rotate(180deg);color:var(--blue-600)}\n.mob-acc-body{background:var(--bg);padding:4px 0 8px}\n.mob-acc-sub{display:block;padding:10px 18px 10px 48px;font-size:13.5px;font-weight:600;color:var(--slate-600);cursor:pointer}\n.mob-acc-sub:hover{background:var(--bg-2);color:var(--blue-600)}\n.mob-acc-sub.mob-acc-all{color:var(--blue-700);font-weight:700}\n[data-theme=\"dark\"] .mob-acc-head:hover,[data-theme=\"dark\"] .mob-acc-sub:hover{background:var(--bg-2)}\n.mob-phone{display:flex;align-items:center;gap:10px;margin:18px;font-weight:800;font-size:17px;color:var(--blue-700)}\n.mob-bottom-nav{display:none;position:fixed;bottom:0;left:0;right:0;z-index:50;background:var(--surface);border-top:1px solid var(--line);height:62px;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -4px 20px rgba(10,28,56,.08)}\n.mbn-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;height:100%;min-width:44px;color:var(--slate-500);font-size:10.5px;font-weight:700;position:relative;padding:0 4px}\n.mbn-item:hover,.mbn-item:active{color:var(--blue-600)}\n.mbn-item.fab{width:52px;height:52px;border-radius:50%;background:var(--grad-brand);color:#fff;margin-top:-12px;box-shadow:0 4px 16px rgba(26,95,208,.35)}\n.mbn-cnt{position:absolute;top:4px;right:4px;min-width:16px;height:16px;background:var(--blue-600);color:#fff;border-radius:99px;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 3px;border:2px solid #fff}\n/* ===== online + view counter ===== */\n.online-widget{display:inline-flex;align-items:center;gap:7px;background:#e7f6ef;border:1px solid #b3e6cc;border-radius:999px;padding:5px 13px;font-size:13px;font-weight:700;color:#15a06a;margin-bottom:14px}\n.ow-dot{width:8px;height:8px;border-radius:50%;background:#15a06a;animation:ow-pulse 2s ease-in-out infinite;flex-shrink:0}\n@keyframes ow-pulse{0%,100%{box-shadow:0 0 0 0 rgba(21,160,106,.4)}50%{box-shadow:0 0 0 6px rgba(21,160,106,0)}}\n.view-counter{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--slate-500);font-weight:600;margin-top:6px}\n/* ===== hero inline form ===== */\n.hero-form{background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:18px;box-shadow:var(--sh-lg);margin-top:24px;max-width:480px}\n.hero-form h4{font-size:15px;font-weight:800;margin-bottom:12px}\n.hero-form-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}\n.hf-input{height:42px;border:1.5px solid var(--line);border-radius:9px;padding:0 13px;font-size:14px;font-family:var(--font);outline:none;width:100%;box-sizing:border-box}\n.hf-input:focus{border-color:var(--blue-500)}\n.hf-ok{display:flex;align-items:center;gap:9px;background:#e7f6ef;color:var(--success);border-radius:10px;padding:12px 16px;font-weight:700;font-size:14px}\n/* ===== calculator ===== */\n.calc-layout{display:grid;grid-template-columns:1fr 300px;gap:36px;padding-top:8px;align-items:start}\n.calc-section{margin-bottom:24px}\n.calc-label{font-size:14px;font-weight:700;color:var(--slate-600);display:block;margin-bottom:10px}\n.calc-type-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px}\n.calc-type-btn,.calc-level-btn{padding:10px 14px;border:1.5px solid var(--line);border-radius:10px;font-weight:700;font-size:13.5px;background:#fff;cursor:pointer;transition:.13s;text-align:left;font-family:var(--font);color:var(--slate-700)}\n.calc-type-btn.on,.calc-level-btn.on{border-color:var(--blue-600);background:var(--blue-600);color:#fff}\n.calc-type-btn:hover:not(.on),.calc-level-btn:hover:not(.on){border-color:var(--blue-400);color:var(--blue-600)}\n.calc-slider{-webkit-appearance:none;width:100%;height:6px;border-radius:99px;background:var(--line);outline:none;cursor:pointer}\n.calc-slider::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:var(--blue-600);border:3px solid #fff;box-shadow:0 2px 8px rgba(26,95,208,.3);cursor:pointer}\n.calc-result{background:linear-gradient(135deg,#eaf3fc,#dbeafb);border:1px solid #c8deff;border-radius:16px;padding:24px;margin-top:8px;text-align:center}\n.cr-label{font-size:13px;font-weight:700;color:var(--slate-500);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}\n.cr-val{font-size:38px;font-weight:800;letter-spacing:-.03em;color:var(--blue-700);line-height:1}\n.cr-cur{font-size:18px;font-weight:600;color:var(--slate-500)}\n.cr-range{font-size:13px;color:var(--slate-500);margin-top:8px}\n@media(max-width:860px){.calc-layout{grid-template-columns:1fr}.mob-hamburger{display:flex}.mob-bottom-nav{display:grid;grid-template-columns:repeat(5,1fr)}.head .search{max-width:200px}.app-main{padding-bottom:72px}.hero-form-row{grid-template-columns:1fr}.hero-form{max-width:100%}.nav{display:none}.ubar .ubar-links,.ubar .ubar-info.delivery{display:none}\n  /* bottom nav already has a call button — hide the floating FAB to avoid a duplicate that overlaps the cart icon */\n  .fab-wrap{display:none}}\n\n/* ===== multi-cat: also-in tags ===== */\n.pdp-also-in{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin:6px 0 10px;font-size:13px;color:var(--slate-500)}\n.pdp-also-in>span{font-weight:700;white-space:nowrap;flex-shrink:0}\n.pdp-cat-tag{display:inline-flex;align-items:center;gap:4px;background:var(--bg-2);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:12.5px;font-weight:700;color:var(--blue-700);cursor:pointer;transition:.13s;white-space:nowrap}\n.pdp-cat-tag:hover{background:var(--blue-600);color:#fff;border-color:var(--blue-600)}\n\n/* ===== variants selector ===== */\n.pdp-variants{margin:14px 0 0;padding:14px 16px;background:var(--bg);border-radius:12px;border:1px solid var(--line)}\n.pv-label{font-size:11.5px;font-weight:800;color:var(--slate-400);text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px}\n.pv-opts{display:flex;flex-wrap:wrap;gap:7px}\n.pv-opt{padding:8px 16px;border:1.5px solid var(--line);border-radius:9px;font-size:13.5px;font-weight:700;background:#fff;color:var(--slate-700);cursor:pointer;transition:.13s;font-family:var(--font)}\n.pv-opt:hover:not(.on){border-color:var(--blue-400);color:var(--blue-600);background:var(--bg-2)}\n.pv-opt.on{border-color:var(--blue-600);background:var(--blue-600);color:#fff;box-shadow:0 2px 8px rgba(23,87,200,.2)}\n\n/* ===== direction group tiles (home + catalog sidebar) ===== */\n.dir-groups-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:4px}\n.dir-group-tile{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--sh-sm);transition:.15s}\n.dir-group-tile:hover{box-shadow:var(--sh);transform:translateY(-2px)}\n.dgt-head{display:flex;align-items:center;gap:14px;padding:20px 22px 16px;cursor:pointer;border-left:4px solid var(--line);transition:.13s}\n.dgt-head:hover{background:var(--bg)}\n.dgt-ic{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.dgt-title-wrap{flex:1;min-width:0}\n.dgt-title{font-size:15.5px;font-weight:800;margin:0 0 3px;line-height:1.25;letter-spacing:-.01em}\n.dgt-count{font-size:12px;font-weight:600;color:var(--slate-400);font-family:var(--mono)}\n.dgt-dirs{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line-soft)}\n.dgt-dir{padding:9px 20px;font-size:13px;font-weight:600;color:var(--slate-700);cursor:pointer;border-bottom:1px solid var(--line-soft);transition:.12s;display:flex;align-items:center;gap:6px;line-height:1.35;text-wrap:pretty}\n.dgt-dir::before{content:\"\";width:5px;height:5px;border-radius:50%;background:var(--line);flex-shrink:0;transition:.12s}\n.dgt-dir:hover{background:var(--bg-2);color:var(--blue-700)}\n.dgt-dir:hover::before{background:var(--blue-500)}\n@media(max-width:860px){.dir-groups-grid{grid-template-columns:1fr}.dgt-dirs{grid-template-columns:1fr}}\n\n/* ===== QUICK VIEW ===== */\n.qv-ov{position:fixed;inset:0;background:rgba(9,24,48,.6);backdrop-filter:blur(5px);z-index:950;display:flex;align-items:center;justify-content:center;padding:16px;animation:fadeIn .15s ease}\n.qv-box{background:var(--surface);border-radius:20px;width:100%;max-width:860px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 32px 80px rgba(9,24,48,.35);animation:slideUp .18s ease}\n@keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}\n@keyframes fadeIn{from{opacity:0}to{opacity:1}}\n.qv-close{position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:50%;background:var(--bg-2);border:1px solid var(--line);color:var(--slate-500);display:flex;align-items:center;justify-content:center;z-index:2;transition:.13s}\n.qv-close:hover{background:var(--slate-200);color:var(--ink)}\n[data-theme=\"dark\"] .qv-close:hover{background:var(--bg)}\n.qv-layout{display:grid;grid-template-columns:1fr 1fr;min-height:420px}\n.qv-img-col{padding:28px 24px 20px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:14px}\n.qv-dirs{display:flex;flex-wrap:wrap;gap:6px}\n.qv-dir-tag{font-size:11.5px;font-weight:700;color:var(--blue-700);background:var(--bg-2);border:1px solid var(--line);border-radius:999px;padding:3px 10px}\n.qv-info{padding:28px 28px 24px;display:flex;flex-direction:column;gap:13px}\n.qv-tags{display:flex;align-items:center;gap:7px;flex-wrap:wrap}\n.qv-title{font-size:18px;font-weight:800;letter-spacing:-.02em;line-height:1.3;margin:0}\n.qv-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.qv-brand{display:flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--slate-700)}\n.qv-country{color:var(--slate-400);font-weight:600}\n.qv-sku{font-size:12px;color:var(--slate-400)}\n.qv-specs{border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.qvs-row{display:grid;grid-template-columns:1fr 1fr;padding:8px 13px;font-size:12.5px;border-bottom:1px solid var(--line-soft)}\n.qvs-row:last-child{border-bottom:none}\n.qvs-row:nth-child(even){background:var(--bg-2)}\n.qvs-k{color:var(--slate-500);font-weight:600}\n.qvs-v{font-weight:700;color:var(--ink)}\n.qv-variants{}\n.qv-buy-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}\n.qv-actions{display:flex;gap:8px;flex-wrap:wrap}\n.qv-actions .flex-1{flex:1;min-width:0;justify-content:center}\n.qv-fullpage{display:flex;align-items:center;gap:6px;color:var(--blue-600);font-size:13px;font-weight:700;margin-top:2px;padding-top:4px;width:fit-content}\n.qv-fullpage:hover{color:var(--blue-800);text-decoration:underline}\n/* qv btn on card hover */\n.card-media{position:relative;overflow:hidden}\n.qv-btn{position:absolute;bottom:10px;left:50%;transform:translateX(-50%) translateY(8px);opacity:0;pointer-events:none;display:flex;align-items:center;gap:6px;background:rgba(9,24,48,.8);backdrop-filter:blur(6px);color:#fff;border-radius:999px;padding:7px 16px;font-size:12px;font-weight:700;transition:.2s cubic-bezier(.34,1.56,.64,1);white-space:nowrap;border:1px solid rgba(255,255,255,.12)}\n.card:hover .qv-btn{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}\n.qv-btn:hover{background:var(--blue-600)}\n@media(max-width:680px){.qv-layout{grid-template-columns:1fr}.qv-img-col{border-right:none;border-bottom:1px solid var(--line);padding:20px}.qv-box{max-height:95vh}.qv-btn{display:none}}\n\n.mli-label{flex:1;min-width:0}\n.mega-count{font-size:11px;font-weight:700;background:var(--bg-2);color:var(--slate-500);border-radius:999px;padding:2px 7px;margin-right:2px;flex-shrink:0}\n.mega-li.on .mega-count{background:rgba(255,255,255,.22);color:#fff}\n\n/* ===== FAQ ===== */\n.faq-group{margin-bottom:32px}\n.faq-cat{font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--blue-600);margin-bottom:14px}\n.faq-item{border:1.5px solid var(--line);border-radius:13px;margin-bottom:10px;background:var(--surface);overflow:hidden;transition:.18s}\n.faq-item.open{border-color:var(--blue-300);box-shadow:0 4px 18px rgba(23,87,200,.08)}\n.faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px;font-size:16px;font-weight:700;color:var(--ink);text-align:left;cursor:pointer}\n.faq-chev{flex-shrink:0;color:var(--slate-400);transition:transform .25s}\n.faq-item.open .faq-chev{transform:rotate(180deg);color:var(--blue-600)}\n.faq-a-wrap{display:grid;grid-template-rows:0fr;transition:grid-template-rows .28s cubic-bezier(.16,1,.3,1)}\n.faq-item.open .faq-a-wrap{grid-template-rows:1fr}\n.faq-a{overflow:hidden;font-size:15px;line-height:1.65;color:var(--slate-600)}\n.faq-item.open .faq-a{padding:0 20px 20px}\n.faq-cta{margin-top:40px;background:var(--bg-2);border-radius:16px;padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}\n.faq-cta-t{font-size:19px;font-weight:800;color:var(--ink);margin-bottom:4px}\n.faq-cta-d{font-size:14.5px;color:var(--slate-500)}\n\n/* ===== CRM Integration ===== */\n.crm-badge{display:inline-flex;align-items:center;gap:8px;border-radius:9px;padding:9px 14px;font-size:13px;font-weight:700;margin:8px auto 0;width:fit-content}\n.crm-badge.ok{background:#e7f6ef;color:var(--success)}\n.crm-badge.err{background:#fff3ee;color:#e0492f}\n.crm-cfg-block{margin-bottom:20px}\n.crm-cfg-label{font-size:13px;font-weight:700;color:var(--slate-600);margin-bottom:6px;display:flex;align-items:center;gap:8px}\n.crm-tag{background:var(--bg-2);color:var(--slate-500);border-radius:6px;padding:2px 8px;font-size:11px;font-weight:700}\n.crm-note{font-size:13px;line-height:1.55;color:var(--slate-500);margin-top:8px;padding:10px 14px;border-radius:9px;background:var(--bg-2)}\n.crm-note.warn{background:#fff8e7;color:#92610a}\n.crm-note.ok{background:#e7f6ef;color:var(--success)}\n.crm-toggle{display:flex;align-items:center;gap:14px;cursor:pointer;padding:16px 20px;background:var(--bg-2);border-radius:12px}\n.crm-toggle input{display:none}\n.crm-toggle-track{width:44px;height:24px;border-radius:999px;background:var(--line);transition:.2s;flex-shrink:0;position:relative}\n.crm-toggle input:checked ~ .crm-toggle-track{background:var(--blue-600)}\n.crm-toggle-knob{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:.2s;box-shadow:0 1px 4px rgba(0,0,0,.2)}\n.crm-toggle input:checked ~ .crm-toggle-track .crm-toggle-knob{left:23px}\n/* spinner on submit */\n.btn-spin{width:17px;height:17px;border:2.5px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;display:inline-block;flex-shrink:0}\n@keyframes spin{to{transform:rotate(360deg)}}\n\n/* ===== CONTACTS MAP ===== */\n.contacts-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:32px;align-items:start;margin-top:8px}\n.contacts-map{position:relative;height:420px;border-radius:18px;overflow:hidden;border:1.5px solid var(--line);box-shadow:var(--sh)}\n.map-card{position:absolute;left:16px;bottom:16px;right:16px;background:var(--surface);border-radius:13px;box-shadow:0 8px 28px rgba(9,24,48,.18);padding:13px 15px;display:flex;align-items:center;gap:12px}\n.map-card-ic{width:38px;height:38px;border-radius:10px;background:var(--blue-600);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.map-card-t{font-weight:800;font-size:14.5px;color:var(--ink)}\n.map-card-d{font-size:12.5px;color:var(--slate-500)}\n.map-card-link{margin-left:auto;display:flex;align-items:center;gap:3px;color:var(--blue-600);font-weight:700;font-size:13px;white-space:nowrap}\n@media(max-width:760px){.contacts-grid{grid-template-columns:1fr}.contacts-map{height:320px}}\n\n/* ===== CATALOG INFINITE SCROLL ===== */\n.cat-loadmore{display:flex;flex-direction:column;align-items:center;gap:16px;padding:36px 0 8px}\n.cat-progress{width:200px;height:4px;background:var(--bg-2);border-radius:999px;overflow:hidden}\n.cat-progress-bar{height:100%;background:var(--grad-brand);border-radius:999px;transition:width .4s cubic-bezier(.16,1,.3,1)}\n.cat-loadmore .btn{display:flex;align-items:center;gap:10px}\n.lm-count{font-family:var(--mono);font-size:12px;color:var(--slate-400);font-weight:600}\n\n/* ===== COOKIE BANNER ===== */\n.cookie-banner{position:fixed;left:0;right:0;bottom:0;z-index:120;padding:16px;animation:cookieUp .4s cubic-bezier(.16,1,.3,1)}\n@keyframes cookieUp{from{transform:translateY(110%)}to{transform:translateY(0)}}\n.cookie-inner{max-width:1080px;margin:0 auto;background:var(--surface);border:1.5px solid var(--line);border-radius:16px;box-shadow:0 12px 48px rgba(9,24,48,.18);padding:18px 22px;display:flex;align-items:center;gap:18px}\n.cookie-ic{width:44px;height:44px;border-radius:12px;background:var(--bg-2);color:var(--blue-600);display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.cookie-text{flex:1;min-width:0}\n.cookie-title{font-weight:800;font-size:15px;margin-bottom:4px;color:var(--ink)}\n.cookie-text p{font-size:12.5px;line-height:1.55;color:var(--slate-500)}\n.cookie-text a{color:var(--blue-600);font-weight:700;cursor:pointer;text-decoration:underline}\n.cookie-actions{display:flex;gap:10px;flex-shrink:0}\n.cookie-actions .btn{height:42px;padding:0 18px;font-size:13.5px;white-space:nowrap}\n@media(max-width:760px){\n  .cookie-inner{flex-direction:column;align-items:flex-start;gap:14px;padding:16px}\n  .cookie-actions{width:100%}\n  .cookie-actions .btn{flex:1}\n  .cookie-ic{display:none}\n}\n\n/* ===== QUOTE MODAL SERVICES ===== */\n.qm-services{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}\n.qm-svc{display:flex;align-items:center;gap:7px;padding:8px 14px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;color:var(--slate-600);background:var(--bg);transition:.13s;user-select:none}\n.qm-svc:hover{border-color:var(--blue-400);color:var(--blue-600)}\n.qm-svc.on{border-color:var(--blue-600);background:var(--blue-600);color:#fff}\n.qm-svc-ic{width:16px;height:16px;border:1.5px solid currentColor;border-radius:4px;display:flex;align-items:center;justify-content:center;flex-shrink:0;opacity:.5;transition:.13s}\n.qm-svc.on .qm-svc-ic{opacity:1;border-color:rgba(255,255,255,.6)}\n\n/* ===== HERO FALLBACK (no video) ===== */\n.hvs-fallback{width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;gap:18px;padding:28px 24px;background:linear-gradient(145deg,#f0f5fc 0%,#e6eef8 100%)}\n.hvs-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}\n.hvs-stat-card{background:#fff;border-radius:14px;padding:14px 14px 12px;box-shadow:0 2px 12px rgba(9,24,48,.07);display:flex;flex-direction:column;gap:3px;animation:hvsFadeUp .5s ease both}\n@keyframes hvsFadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}\n.hvs-stat-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:4px}\n.hvs-stat-n{font-size:22px;font-weight:900;letter-spacing:-.02em;color:var(--navy-800)}\n.hvs-stat-l{font-size:11.5px;font-weight:600;color:var(--slate-500)}\n.hvs-cats{display:flex;flex-wrap:wrap;gap:7px}\n.hvs-cat-pill{display:flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:700;color:var(--slate-700);animation:hvsFadeUp .5s ease both;box-shadow:0 1px 4px rgba(9,24,48,.06)}\n.hvs-upload-hint{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--slate-400);cursor:pointer;margin-top:2px;width:fit-content}\n.hvs-upload-hint:hover{color:var(--blue-600)}\n[data-theme=\"dark\"] .hvs-fallback{background:linear-gradient(145deg,var(--bg-2) 0%,var(--surface) 100%)}\n[data-theme=\"dark\"] .hvs-stat-card,[data-theme=\"dark\"] .hvs-cat-pill{background:var(--surface);border-color:var(--line)}\n[data-theme=\"dark\"] .hvs-stat-n{color:var(--ink)}\n\n/* ===== B2B PRICING ===== */\n.vat-toggle{display:inline-flex;gap:0;border:1.5px solid var(--line);border-radius:9px;overflow:hidden;margin-bottom:12px}\n.vat-toggle button{padding:6px 16px;font-size:12.5px;font-weight:700;color:var(--slate-500);background:var(--surface);transition:.13s;font-family:var(--font)}\n.vat-toggle button.on{background:var(--blue-600);color:#fff}\n.vat-toggle button:not(.on):hover{background:var(--bg-2);color:var(--blue-600)}\n.vat-note{font-size:12px;color:var(--slate-400);margin-top:4px;font-weight:600;min-height:16px}\n/* bulk */\n.bulk-block{margin:16px 0 4px;padding:14px 16px;background:var(--bg);border:1px solid var(--line);border-radius:12px}\n.bulk-title{font-size:11.5px;font-weight:800;color:var(--slate-400);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}\n.bulk-tiers{display:flex;gap:9px;flex-wrap:wrap}\n.bulk-tier{flex:1;min-width:130px;display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:10px 13px;border:1.5px solid var(--line);border-radius:10px;background:var(--surface);cursor:pointer;transition:.13s;position:relative;text-align:left}\n.bulk-tier:hover{border-color:var(--blue-400)}\n.bulk-tier.on{border-color:var(--blue-600);background:var(--blue-50,#eef4ff);box-shadow:0 2px 8px rgba(23,87,200,.12)}\n[data-theme=\"dark\"] .bulk-tier.on{background:rgba(23,87,200,.16)}\n.bt-qty{font-size:11.5px;font-weight:700;color:var(--slate-500)}\n.bt-price{font-size:14.5px;font-weight:800;color:var(--ink);font-family:var(--mono);letter-spacing:-.01em}\n.bt-save{position:absolute;top:8px;right:10px;font-size:11px;font-weight:800;color:#15a06a;background:rgba(21,160,106,.12);border-radius:6px;padding:2px 6px}\n/* price on request */\n.por-block{padding:18px 20px;background:linear-gradient(135deg,var(--bg-2) 0%,var(--bg) 100%);border:1.5px dashed var(--blue-400);border-radius:14px;margin-bottom:16px}\n.por-label{display:flex;align-items:center;gap:8px;font-size:21px;font-weight:900;letter-spacing:-.02em;color:var(--blue-700)}\n.por-note{font-size:13px;color:var(--slate-500);margin-top:6px;line-height:1.45;font-weight:500}\n[data-theme=\"dark\"] .por-label{color:var(--blue-500)}\n.theme-toggle{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--bg-2);border:1px solid var(--line);color:var(--slate-600);font-size:15px;cursor:pointer;transition:.15s;flex-shrink:0;line-height:1;padding:0}\n.theme-toggle:hover{background:var(--blue-600);color:#fff;border-color:transparent}\n\n/* ===== ТЁМНАЯ ТЕМА ===== */\n[data-theme=\"dark\"]{\n  --ink:#cfdae8;\n  --slate-700:#aabcce;\n  --slate-600:#849eb6;\n  --slate-500:#60809a;\n  --slate-400:#446278;\n  --line:#1c3048;\n  --line-soft:#152538;\n  --bg:#0a1825;\n  --bg-2:#0d1e2c;\n  --surface:#122030;\n  --navy-900:#040c18;\n  --navy-850:#07101e;\n  --navy-800:#0a1628;\n  --navy-700:#0e1e34;\n  --grad-hero:linear-gradient(160deg,#0a1825 0%,#0d1e2c 45%,#09162200 100%);\n  color-scheme:dark;\n}\n[data-theme=\"dark\"] body{background:var(--bg) !important;color:var(--ink)}\n/* Белые фоны → поверхность */\n[data-theme=\"dark\"] .ubar,[data-theme=\"dark\"] .foot-pay span{background:var(--surface)}\n[data-theme=\"dark\"] .lang{background:var(--bg-2);border-color:var(--line)}\n[data-theme=\"dark\"] .mega,[data-theme=\"dark\"] .search-drop{background:var(--surface);border-color:var(--line)}\n[data-theme=\"dark\"] .search:focus-within{background:var(--surface)}\n[data-theme=\"dark\"] .mega-cta{background:var(--bg-2)}\n[data-theme=\"dark\"] .mega-list{background:var(--bg)}\n/* Карточки */\n[data-theme=\"dark\"] .pcard,[data-theme=\"dark\"] .dir-group-tile,[data-theme=\"dark\"] .rev-card,\n[data-theme=\"dark\"] .kit-card,[data-theme=\"dark\"] .track-card,[data-theme=\"dark\"] .news-card,\n[data-theme=\"dark\"] .nhg-card,[data-theme=\"dark\"] .inf